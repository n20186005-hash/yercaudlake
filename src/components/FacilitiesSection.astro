---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
const facilitiesTa = [
  {
    "icon": "🚻",
    "title": "கழிவறைகள் (WC)",
    "text": "தற்போது திறந்துள்ள கழிப்பிடம், கட்டணம் மற்றும் அணுகல் தேவைகளைப் படகு இல்லத்தில் முன்கூட்டியே கேளுங்கள். விழாக்கால ஏற்பாடு ஆண்டு முழுவதற்கான வசதிக்குச் சான்றல்ல."
  },
  {
    "icon": "🅿️",
    "title": "வாகன நிறுத்தம்",
    "text": "அனுமதிக்கப்பட்ட வாகன நிறுத்தம், தற்போதைய கட்டணம் மற்றும் நுழைவிடம் வரை நடக்கும் பகுதியை உள்ளூரில் உறுதி செய்யுங்கள். இடம் கிடைப்பது உறுதி அல்ல."
  },
  {
    "icon": "🍛",
    "title": "உணவு & பானங்கள்",
    "text": "தண்ணீர் எடுத்துச் செல்லுங்கள். உணவு வாங்கும் இடத்தின் நேரம், பட்டியல், விலை மற்றும் சுகாதாரத்தைச் சரிபாருங்கள்; ஏரிக்கரைக் கடை திறந்திருக்கும் எனக் கருதாதீர்கள்."
  },
  {
    "icon": "🛏️",
    "title": "தங்குமிடங்கள்",
    "text": "குறிப்பிட்ட தங்குமிடத்தின் தற்போதைய முகவரி, முன்பதிவு விதி மற்றும் ஏரி வரையிலான பயணத்தைச் சரிபாருங்கள். இது சரிபார்க்கப்பட்ட விடுதிப் பட்டியல் அல்ல."
  },
  {
    "icon": "🛒",
    "title": "பல்பொருள் கடைகள்",
    "text": "மலைப் பயணத்திற்கு முன் தேவையான பொருட்களைத் தயார் செய்யுங்கள். வந்தவுடன் குறிப்பிட்ட கடையோ பொருளோ கிடைக்கும் என நம்பாதீர்கள்."
  },
  {
    "icon": "⛽",
    "title": "எரிபொருள் & EV சார்ஜிங்",
    "text": "வாகனம் ஓட்டும் முன் எரிபொருள் அல்லது சார்ஜிங் வழங்குநரின் தற்போதைய இடம் மற்றும் கிடைப்பைச் சரிபாருங்கள். குறிப்பிட்ட மலை சார்ஜிங் இடம் இங்கு உறுதி செய்யப்படவில்லை."
  },
  {
    "icon": "🏧",
    "title": "ATM & ரொக்கம்",
    "text": "தேவைப்பட்டால் உங்கள் வங்கியின் தற்போதைய ATM இடத்தைக் காணுங்கள். கட்டண கவுண்டரில் ஏற்றுக்கொள்ளும் செலுத்தும் முறையைக் கேளுங்கள்; மின்னணு செலுத்தல் உறுதி அல்ல."
  },
  {
    "icon": "💊",
    "title": "மருந்தகம் & மருத்துவம்",
    "text": "தனிப்பட்ட மருந்து மற்றும் பொருத்தமான தற்போதைய மருத்துவ உதவியைப் பயணத்திற்கு முன் திட்டமிடுங்கள். அருகிலுள்ள மருத்துவமனையோ அவசர உதவி நேரமோ இங்கு உறுதி செய்யப்படவில்லை."
  },
  {
    "icon": "📶",
    "title": "இணையம் & தொலைபேசி வலைப்பின்னல்",
    "text": "முகவரி, வழி மற்றும் திரும்பச் சந்திக்கும் இடத்தை இணையமின்றியும் பார்க்குமாறு வைத்திருங்கள். அலைபேசி இணைப்பு மாறலாம்; இந்த வழிகாட்டி உறுதி தராது."
  },
  {
    "icon": "♿",
    "title": "மாற்றுத்திறன் அணுகல்",
    "text": "சக்கர நாற்காலியுடன் படகில் ஏறுதல், சரிவு, பாதை மற்றும் அணுகத்தக்க கழிப்பிடம் இங்கு ஆய்வு செய்யப்படவில்லை. உங்கள் குறிப்பிட்ட தேவையைப் படகு இல்லத்தில் முன்பே கேளுங்கள்; அண்ணா பூங்கா அருகில் இருப்பது தடையற்ற பாதைக்குச் சான்றல்ல."
  }
];
const facilitiesEn = [
  {
    "icon": "🚻",
    "title": "Toilets (WC)",
    "text": "Ask the boat house about the nearest currently open toilet, charges and access needs before relying on it. Festival-only arrangements are not evidence of a year-round facility."
  },
  {
    "icon": "🅿️",
    "title": "Parking",
    "text": "Confirm permitted parking, current charges and the walking section to the visitor entrance locally. A space is not guaranteed."
  },
  {
    "icon": "🍛",
    "title": "Food & drinks",
    "text": "Carry drinking water. If buying a meal, check the actual venue’s opening, menu, price and hygiene rather than assuming a stall is open beside the lake."
  },
  {
    "icon": "🛏️",
    "title": "Stays",
    "text": "Check a specific property’s current address, booking terms and journey to the lake. This card is not a verified accommodation directory."
  },
  {
    "icon": "🛒",
    "title": "Groceries",
    "text": "Bring essentials before leaving for the hills. Do not rely on a particular nearby shop or product being available on arrival."
  },
  {
    "icon": "⛽",
    "title": "Fuel & EV charging",
    "text": "Use your fuel or charging provider’s current location and availability information before driving. No particular hill charging point has been verified here."
  },
  {
    "icon": "🏧",
    "title": "ATM & cash",
    "text": "Check your bank’s current ATM locator if needed. Ask the ticket counter which payment methods it accepts; do not assume cashless payment."
  },
  {
    "icon": "💊",
    "title": "Pharmacy & medical",
    "text": "Prepare personal medication and identify suitable current medical help before travel. This guide has not verified a nearby clinic or emergency response time."
  },
  {
    "icon": "📶",
    "title": "Internet & phone network",
    "text": "Keep the address, route and return meeting point available offline. Network coverage varies and is not guaranteed by this guide."
  },
  {
    "icon": "♿",
    "title": "Accessible",
    "text": "Wheelchair boarding, ramps, path surfaces and accessible toilets have not been surveyed here. Contact the boat house about your particular needs before travelling; proximity to Anna Park does not prove a continuous step-free route."
  }
];
const facilities = locale === 'en' ? facilitiesEn : facilitiesTa;
const allText = pick(locale, "இந்த அட்டைகள் பயணத்திற்கு முன் என்ன கேட்க வேண்டும் என்பதற்கான உதவி; தற்போதைய சேவைகளின் உறுதியான பட்டியல் அல்ல.", "These cards are questions to resolve before travel, not a verified inventory of currently available services.");
const kicker = pick(locale, 'பயண வசதிகள்', 'Visitor facilities');
const heading = pick(locale, 'ஏரிக்கரை & ஏற்காடு நகரில் தேவையானவை', 'What you need at the lakeside & Yercaud town');
const footnote = pick(locale, "குறிப்பிட்ட வசதியின் இடம், திறந்த நேரம் மற்றும் உங்கள் தேவைக்கேற்ற பயன்பாட்டை நேரடியாக உறுதி செய்யுங்கள்.", "Confirm the particular facility’s location, opening and suitability directly.");
---
<section id={sec(locale, 'facilities')} class="container-shell py-16 md:py-24">
  <p class="kicker">{kicker}</p>
  <h2 class="section-title mt-3">{heading}</h2>
  <p class="mt-4 max-w-3xl text-sm leading-7 text-[#48605a]">{allText}</p>
  <div class="mt-9 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {facilities.map((f) => (
      <article class="card p-6">
        <div class="text-3xl" aria-hidden="true">{f.icon}</div>
        <h3 class="mt-4 text-lg font-black text-[#0b4148]">{f.title}</h3>
        <p class="mt-3 text-sm leading-7 text-[#48605a]">{f.text}</p>
      </article>
    ))}
  </div>
  <p class="mt-6 rounded-2xl bg-[#eaf4ee] px-5 py-4 text-xs leading-6 text-[#35504a]">{footnote}</p>
</section>
