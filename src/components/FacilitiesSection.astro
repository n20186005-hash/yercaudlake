---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
const facilitiesTa = [
  {
    icon: '🚻', title: 'கழிவறைகள் (WC)',
    text: 'படகு இல்ல வளாகம் மற்றும் ஏரிக்கரைப் பகுதியில் பொது கழிவறை வசதியை எதிர்பார்க்கலாம். நாள் நேரம், பராமரிப்பு மற்றும் நெரிசலைப் பொறுத்து நிலை மாறலாம்; சில சமயங்களில் காத்திருப்பு அல்லது சிறு கட்டணம் இருக்கலாம்.'
  },
  {
    icon: '🅿️', title: 'வாகன நிறுத்தம்',
    text: 'லேக் ரோடு மற்றும் படகு இல்லத்திற்கு அருகில் வாகன நிறுத்தம் உள்ளது. இரு சக்கர மற்றும் நான்கு சக்கர வாகனங்களுக்கு இடம் உண்டு; வார இறுதி, விடுமுறை நாட்களில் நிரம்பக்கூடும் என்பதால் முன்னதாக வருவது நடைமுறை.'
  },
  {
    icon: '🍛', title: 'உணவு & பானங்கள்',
    text: 'ஏரிக்கரை மற்றும் ஏற்காடு நகரில் தென்னிந்திய சைவ உணவு, இட்லி/தோசை போன்ற டிபன் வகைகள், காப்பி–தேநீர் கடைகள், சிற்றுண்டி மற்றும் பேக்கரிகள் உள்ளன. பயணத்தின் போது குடிநீர் பாட்டில் எடுத்துச் செல்வது நல்லது.'
  },
  {
    icon: '🛏️', title: 'தங்குமிடங்கள்',
    text: 'ஏற்காடு நகரில் ஹோட்டல், ரிசார்ட், மலை வீடு (ஹோம்ஸ்டே) போன்ற பல தங்குமிட வகைகள் உள்ளன. முன்பதிவு, ஏரிக்கான தொலைவு, பருவம் ஆகியவற்றை ஒப்பிட்டு முடிவு செய்யுங்கள். இங்கு குறிப்பிட்ட நிறுவனப் பெயர்கள் பரிந்துரைக்கப்படவில்லை.'
  },
  {
    icon: '🛒', title: 'பல்பொருள் கடைகள்',
    text: 'தினசரி தேவைப் பொருட்கள், காய்கறிகள், பழங்கள், சிற்றுண்டி மற்றும் குடிநீர் ஆகியவை நகரில் கிடைக்கின்றன. ஏரியிலிருந்து வெளியேறிச் செல்லும் பயணங்களுக்குத் தேவையானவற்றை முன்கூட்டியே எடுத்துச் செல்வது வசதியாக இருக்கும்.'
  },
  {
    icon: '⛽', title: 'எரிபொருள் & EV சார்ஜிங்',
    text: 'சேலம்–ஏற்காடு சாலை வழியிலும் நகரிலும் எரிபொருள் நிலையங்கள் உள்ளன. மலைப்பகுதியில் மின்சார வாகன சார்ஜிங் வசதி குறைவாக இருக்கலாம்; மேலே வரும் முன் சேலத்தில் பேட்டரியை முழுமையாக நிரப்பி வருவது பாதுகாப்பானது.'
  },
  {
    icon: '🏧', title: 'ATM & ரொக்கம்',
    text: 'நகர மையத்தில் வங்கி மற்றும் ATM வசதிகள் உள்ளன. ஏரிக்கரைப் பகுதியில் ATM இருக்காது என்பதால் சிறிய அளவு ரொக்கம் எடுத்துச் செல்வது நல்லது.'
  },
  {
    icon: '💊', title: 'மருந்தகம் & மருத்துவம்',
    text: 'ஏற்காடு நகரில் மருந்தகங்களும் அடிப்படை சுகாதார வசதியும் உள்ளன. அவசர மருத்துவத் தேவைக்கு அருகிலுள்ள பெரிய மையம் சேலம்; பயணத்தின் போது முக்கிய அவசரத் தொடர்புகளைக் குறித்துக்கொள்வது நல்லது.'
  },
  {
    icon: '📶', title: 'இணையம் & தொலைபேசி வலைப்பின்னல்',
    text: 'நகர் மையம் & ஏரிக்கரைப் பகுதியில் செல்பேசி வலைப்பின்னல் கிடைக்கும்; ஆழமான மலைப் பாதைகளில் 4G சிக்னல் துண்டிக்கப்படலாம். மலைச்சாலைக்கு முன் வழிசெலுத்தலை (offline map) பதிவிறக்கம் செய்துகொள்வது பாதுகாப்பானது.'
  },
  {
    icon: '♿', title: 'மாற்றுத்திறன் அணுகல்',
    text: 'ஏரிக்கரை பேவ்டு (paved) நடைப்பாதை, படகு இல்லம் மற்றும் அண்ணா பூங்கா ஆகியவை சக்கர நாற்காலிக்கு ஏற்ற வகையில் அமைந்துள்ளன. வாகனம் மூலம் அணுகக்கூடிய காட்சிஇடங்களும் உள்ளன; ஆழமான பாதைகள் & அருவிகளில் அணுகல் குறைவாக இருக்கலாம்.'
  }
];
const facilitiesEn = [
  {
    icon: '🚻', title: 'Toilets (WC)',
    text: 'Public toilets can be expected at the boat-house complex and lakeside. Condition varies with time of day, maintenance and crowding; sometimes there is a wait or a small fee.'
  },
  {
    icon: '🅿️', title: 'Parking',
    text: 'Parking is available near Lake Road and the boat house for two- and four-wheelers; it can fill up on weekends and holidays, so arriving earlier is practical.'
  },
  {
    icon: '🍛', title: 'Food & drinks',
    text: 'Lakeside and in Yercaud town you’ll find South Indian vegetarian food, tiffin items like idli/dosa, coffee–tea stalls, snacks and bakeries. Carry a bottle of drinking water on your trip.'
  },
  {
    icon: '🛏️', title: 'Stays',
    text: 'Yercaud town has hotels, resorts and homestays of various types. Compare distance to the lake, season and reviews before booking; no specific business is recommended here.'
  },
  {
    icon: '🛒', title: 'Groceries',
    text: 'Daily-needs items, vegetables, fruit, snacks and drinking water are available in town. It is convenient to stock up before trips that leave the lake area.'
  },
  {
    icon: '⛽', title: 'Fuel & EV charging',
    text: 'Fuel stations are along the Salem–Yercaud road and in town. EV charging in the hills may be limited; it is safer to fully charge in Salem before climbing up.'
  },
  {
    icon: '🏧', title: 'ATM & cash',
    text: 'Bank and ATM facilities are in the town centre. There may be no ATM lakeside, so carry a little cash.'
  },
  {
    icon: '💊', title: 'Pharmacy & medical',
    text: 'Yercaud town has pharmacies and basic healthcare. For emergencies the nearest major centre is Salem; note key emergency numbers while travelling.'
  },
  {
    icon: '📶', title: 'Internet & phone network',
    text: 'Mobile network is available in the town centre and lakeside; 4G signal can drop on deep hill trails. Download an offline map before the ghat road for safety.'
  },
  {
    icon: '♿', title: 'Accessible',
    text: 'The lakeside paved walkway, boat house and Anna Park are wheelchair-friendly. Vehicle-accessible viewpoints exist; deeper trails and waterfalls may have limited access.'
  }
];
const facilities = locale === 'en' ? facilitiesEn : facilitiesTa;
const allText = pick(locale,
  'இது வணிகப் பட்டியல் அல்ல — வசதி வகைகள் மட்டுமே கீழே தரப்படுகின்றன. குறிப்பிட்ட கடை, ஹோட்டல் அல்லது நிறுவனப் பெயர் எதுவும் பரிந்துரைக்கப்படவில்லை; தேர்வும் முடிவும் பயணியின் பொறுப்பு.',
  'This is not a commercial listing — only facility types are listed below. No specific shop, hotel or business is recommended; the choice and decision rest with the visitor.');
const kicker = pick(locale, 'பயண வசதிகள்', 'Visitor facilities');
const heading = pick(locale, 'ஏரிக்கரை & ஏற்காடு நகரில் தேவையானவை', 'What you need at the lakeside & Yercaud town');
const footnote = pick(locale,
  'சில காலங்களில் பராமரிப்பு, விடுமுறை அல்லது பருவநிலை காரணமாக வசதிகளின் செயல்பாடு மாறலாம். பயண நாளில் உள்ளூரில் மீண்டும் உறுதிப்படுத்தவும்.',
  'At some times facilities may operate differently due to maintenance, holidays or weather. Reconfirm locally on the day of travel.');
---
<section id={sec(locale, 'facilities')} class="container-shell py-16 md:py-24">
  <p class="kicker">{kicker}</p>
  <h2 class="section-title mt-3">{heading}</h2>
  <p class="mt-4 max-w-3xl text-sm leading-7 text-[#48605a]">{allText}</p>
  <div class="mt-9 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    {facilities.map((f) => (
      <article class="card p-6">
        <div class="text-3xl" aria-hidden="true">{f.icon}</div>
        <h3 class="mt-4 text-lg font-black text-[#0b4148]">{f.title}</h3>
        <p class="mt-3 text-sm leading-7 text-[#48605a]">{f.text}</p>
      </article>
    ))}
  </div>
  <p class="mt-6 rounded-2xl bg-[#eaf4ee] px-5 py-4 text-xs leading-6 text-[#35504a]">{footnote}</p>
</section>
