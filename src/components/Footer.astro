---
import Logo from './Logo.astro';
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
const p1 = pick(locale,
  'இந்த இணையதளம் ஒரு சுயாதீன, இலாப நோக்கமற்ற பயணிகள் தகவல் வழிகாட்டி திட்டமாகும். எந்த அரசு அமைப்பு அல்லது அதிகாரப்பூர்வ நிறுவனத்துடனும் நிர்வாகத் தொடர்பு இல்லை.',
  'This website is an independent, non-profit visitor information guide. It has no administrative affiliation with any government body or official institution.');
const p2 = pick(locale, "மாவட்டத்தின் குறிப்பிட்ட தேதியுள்ள பக்கங்கள் மற்றும் இணைக்கப்பட்ட மூலங்கள் பயன்படுத்தப்பட்டுள்ளன; நேரம், கட்டணம் மற்றும் அணுகல் மாறலாம். 25 அக்டோபர் 2026 அன்று மூலங்கள் பார்க்கப்பட்டன.", "Specific dated district pages and the linked sources inform this guide. Hours, charges and access can change. Sources checked 25 October 2026.");
const p3 = pick(locale, "ஒவ்வொரு புகைப்படத்தின் ஆசிரியர், மூலம் மற்றும் தனி உரிமம் புகைப்படத் தொகுப்பு மற்றும் வெளியிடப்பட்ட CREDITS பதிவில் உள்ளது.", "Each photograph’s author, source and individual licence are shown in the gallery and published credits.");
const travelH = pick(locale, 'பயணத் தகவல்', 'Travel info');
const legalH = pick(locale, 'சட்டத் தகவல்', 'Legal');
const srcH = pick(locale, 'அதிகாரப்பூர்வ ஆதாரங்கள்', 'Official sources');
const copy = pick(locale, '© 2026 ஏற்காடு ஏரி பயண வழிகாட்டி. அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.', '© 2026 Yercaud Lake Visitor Guide. All rights reserved.');
const travelLinks = [
  { label: pick(locale, 'ஏரி அறிமுகம்', 'Lake introduction'), id: sec(locale, 'intro') },
  { label: pick(locale, 'வசதிகள்', 'Facilities'), id: sec(locale, 'facilities') },
  { label: pick(locale, 'வரலாறு & கதைகள்', 'History & stories'), id: sec(locale, 'history') },
  { label: pick(locale, 'வானிலை முன்னறிவிப்பு', 'Weather forecast'), id: sec(locale, 'weather') },
  { label: pick(locale, 'புகைப்படத் தொகுப்பு', 'Photo gallery'), id: sec(locale, 'gallery') },
  { label: pick(locale, 'பொதுக் கேள்விகள்', 'FAQ'), id: sec(locale, 'faq') }
];
const base = locale === 'en' ? '/en/' : '/';
const legalBase=locale==='en'?'/en/':'/';
---
<footer class="mt-20 bg-[#0b3436] text-[#f9f5e9]">
  <div class="container-shell grid gap-10 py-14 lg:grid-cols-[1.2fr_.8fr]">
    <div><Logo/><div class="mt-6 max-w-3xl space-y-3 text-sm leading-7 text-white/75">
      <p>{p1}</p>
      <p>{p2}</p>
      <p>{p3}</p>
    </div></div>
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      <div><h2 class="font-extrabold">{travelH}</h2><ul class="mt-3 space-y-2 text-sm text-white/72">{travelLinks.map((l) => <li><a href={`${base}#${l.id}`}>{l.label}</a></li>)}</ul></div>
      <div><h2 class="font-extrabold">{legalH}</h2><ul class="mt-3 space-y-2 text-sm text-white/72">
        <li><a href="/CREDITS.txt">{pick(locale,'புகைப்பட உரிமங்கள்','Photograph credits')}</a></li>
        <li><a href={`${legalBase}privacy/`}>{pick(locale, 'தனியுரிமைக் கொள்கை', 'Privacy Policy')}</a></li>
        <li><a href={`${legalBase}terms/`}>{pick(locale, 'சேவை விதிமுறைகள்', 'Terms of Service')}</a></li>
        <li><a href={`${legalBase}cookies/`}>{pick(locale, 'குக்கீ அமைப்புகள்', 'Cookie Settings')}</a></li>
      </ul></div>
      <div><h2 class="font-extrabold">{srcH}</h2><ul class="mt-3 space-y-2 text-sm text-white/72">
        <li><a target="_blank" rel="noopener noreferrer" href="https://salem.nic.in/tourist-place/images-of-yercaudlake/">{pick(locale, 'சேலம் மாவட்ட நிர்வாகம்', 'Salem District Administration')}</a></li>
        <li><a target="_blank" rel="noopener noreferrer" href="https://www.tamilnadutourism.tn.gov.in/">{pick(locale, 'தமிழ்நாடு சுற்றுலாத்துறை', 'Tamil Nadu Tourism')}</a></li>
        <li><a target="_blank" rel="noopener noreferrer" href="https://tourism.gov.in/">{pick(locale, 'இந்திய சுற்றுலா அமைச்சகம்', 'Ministry of Tourism, India')}</a></li>
      </ul></div>
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs text-white/55">{copy}</div>
</footer>
