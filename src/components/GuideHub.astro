---
// Homepage entry point to the guide set: one card per family, one link per page.
// Also the crawl path that connects the home pages to all 42 guide topics.
import { type Locale, pick, sec } from '../i18n';
import { familyGroups } from '../data/guides';
import { FAMILIES } from '../data/guides/types';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
const hubId = sec(locale, 'guides');
const kicker = pick(locale, 'வழிகாட்டிகள்', 'Guides');
const heading = pick(locale, 'ஏரியை மையமாகக் கொண்ட வழிகாட்டிகள்', 'Guides built around the lake');
const intro = pick(
  locale,
  'ஏற்காடு ஏரியில் தொடங்கி, படகு சவாரி, வானிலை, போக்குவரத்து, உணவு, அருகிலுள்ள இடங்கள் மற்றும் பயணத் திட்டங்கள் வரை ஒவ்வொரு தனிக் கேள்விக்கும் ஒரு தனிப் பக்கம். ஒவ்வொரு பக்கமும் தேதியிட்ட ஆதாரங்களுடன், பயண நாளில் மீண்டும் சரிபார்க்க வேண்டிய தகவல்களைத் தெளிவாகக் குறிக்கிறது.',
  'Start at Yercaud Lake and go from there: boating, visiting, getting there, food, nearby places and itineraries. Each page answers one question with dated sources and a clear note on what to reconfirm on the day.'
);
const href = (slug: string) => (locale === 'en' ? `/en/${slug}/` : `/${slug}/`);
const linkText = (en: string, ta: string) => (locale === 'en' ? en : ta);
const base = Astro.site ? Astro.site.href.replace(/\/+$/, '') : '';
const collection = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: heading,
  description: intro,
  hasPart: familyGroups.flatMap(({ pages }) =>
    pages.map((page) => ({
      '@type': 'Article',
      headline: linkText(page.en.title, page.ta.title),
      url: base + href(page.slug)
    }))
  )
};
---
<section id={hubId} class="container-shell py-16 md:py-22">
  <p class="kicker">{kicker}</p>
  <h2 class="section-title mt-3">{heading}</h2>
  <p class="mt-4 max-w-3xl leading-8 text-[#415a54]">{intro}</p>
  <div class="mt-9 grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
    {familyGroups.map(({ family, pages }) => (
      <div class="card p-6">
        <h3 class="text-xl font-black text-[#0b4148]">{FAMILIES[family][locale]}</h3>
        <ul class="mt-4 grid gap-3 text-sm">
          {pages.map((page) => (
            <li>
              <a class="font-bold text-[#0d6d70] underline" href={href(page.slug)}>{linkText(page.en.title, page.ta.title)}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<script is:inline type="application/ld+json" set:html={JSON.stringify(collection)} />
