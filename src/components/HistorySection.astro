---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
const blocksTa = [
  {
    "icon": "🏞️",
    "title": "பெரிய ஏரி",
    "text": "மாவட்ட சுற்றுலாப் பக்கம் ஏற்காட்டின் பெரிய ஏரியை இயற்கை ஏரி மற்றும் படகுச் சுற்றுலா இடமாகக் குறிப்பிடுகிறது. ஏரியையும் படகு இல்லச் சேவையையும் வேறுபடுத்திப் பாருங்கள்."
  },
  {
    "icon": "⛰️",
    "title": "சேர்வராயன் மலைப்பகுதி",
    "text": "ஏற்காடு கிழக்குத் தொடர்ச்சி மலையின் சேர்வராயன் பகுதியில் உள்ளது. மாவட்டம் நகரத்திற்கு சுமார் 1,515 மீ உயரம் குறிப்பிடுகிறது; அது ஏரி வானிலை நிலையத்தின் துல்லிய உயரம் அல்ல."
  },
  {
    "icon": "☕",
    "title": "அருகிலுள்ள அண்ணா பூங்கா",
    "text": "அண்ணா பூங்கா ஏரிக்கு அருகில் இருப்பதாக மாவட்டம் குறிப்பிடுகிறது. அதன் நுழைவு தனியானது; அருகில் இருப்பது ஒரே டிக்கெட் அல்லது தடையற்ற அணுகலுக்குச் சான்றல்ல."
  },
  {
    "icon": "⛵",
    "title": "படகு இல்ல இயக்குநர்",
    "text": "23 மே 2025 அன்று புதுப்பிக்கப்பட்ட மாவட்டப் படகு இல்லப் பக்கம் TTDC மற்றும் மிதி, துடுப்பு, இயந்திரப் படகுகளைக் குறிப்பிடுகிறது. தற்போது இயங்குவதையும் கவுண்டர் விதியையும் உறுதி செய்யுங்கள்."
  },
  {
    "icon": "🌤️",
    "title": "வரைபடப் பெயர்கள்",
    "text": "இந்த ஏற்காடு இடத்திற்கு பெரிய ஏரி மற்றும் எமரால்ட் ஏரி பெயர்கள் பயன்படுத்தப்படுகின்றன. வேறு எமரால்ட் ஏரி அல்லது ஒத்த பெயருள்ள வணிகத்துடன் குழப்பாதீர்கள்."
  },
  {
    "icon": "🏛️",
    "title": "கிளியூர் அருவிப் பின்னணி",
    "text": "ஏற்காடு பகுதியின் அருவி மற்றும் ஏரி உபரிநீர், மலை நீரோட்டத் தொடர்பை மாவட்டம் விவரிக்கிறது. அது இன்றைய நீர்வரத்து அல்லது திறந்த பாதைக்கு உறுதி அல்ல."
  },
  {
    "icon": "🚤",
    "title": "தேதியுள்ள பயணத் தகவல்",
    "text": "மாவட்டப் பொதுப்பக்கம் 2018 தேதியுடையது; படகு இல்ல விழாப் பக்கம் 2025இல் புதுப்பிக்கப்பட்டது. அவற்றின் விலையும் நேரமும் இன்றைய உறுதியான சேவையாக அல்லாமல் அந்தத் தேதியுடன் படிக்கப்பட வேண்டும்."
  }
];
const blocksEn = [
  {
    "icon": "🏞️",
    "title": "The Big Lake",
    "text": "The district tourism page identifies Yercaud’s Big Lake as a natural lake and boating attraction. Keep the lake itself distinct from the boat-house service."
  },
  {
    "icon": "⛰️",
    "title": "Shevaroy setting",
    "text": "Yercaud is in the Shevaroy range of the Eastern Ghats. The district gives about 1,515 m for the town; this is not a precise lake weather-station elevation."
  },
  {
    "icon": "☕",
    "title": "Anna Park nearby",
    "text": "The district places Anna Park next to the lake. Its garden visit has separate entry arrangements; proximity is not proof of shared tickets or step-free access."
  },
  {
    "icon": "⛵",
    "title": "Boat-house operator",
    "text": "The district’s boat-house page, updated 23 May 2025, identifies TTDC and pedal, rowing and motor-boat services. Confirm which currently operate and their counter rules."
  },
  {
    "icon": "🌤️",
    "title": "Names on the map",
    "text": "Big Lake and Emerald Lake are used for this Yercaud attraction. Do not confuse it with a different Emerald Lake or a similarly named business elsewhere."
  },
  {
    "icon": "🏛️",
    "title": "Kiliyur Falls context",
    "text": "The district describes a waterfall trip from the Yercaud area and a connection to lake overflow and hill runoff. That description does not establish today’s water flow or open trail."
  },
  {
    "icon": "🚤",
    "title": "Reading dated visitor information",
    "text": "The district’s general page is dated 2018; its boat-house festival page was updated 2025. Their prices and hours should be read with those dates, not as today’s confirmed offer."
  }
];
const blocks = locale === 'en' ? blocksEn : blocksTa;
const kicker = pick(locale, 'வரலாறு & தன்மை', 'History & nature');
const heading = pick(locale, 'செவராய் மலைச் சரிவில் ஒரு இயற்கை ஏரி', 'A natural lake on the Shevaroy slope');
const footnote = pick(locale, "மாவட்டத்தின் 2018 பொதுப்பக்கம் மற்றும் 2025 படகு இல்லப் பக்கம் அடிப்படைச் சூழலைத் தருகின்றன. அவற்றின் தேதியை தற்போதைய சேவைக்கான உறுதியாகக் கருதாதீர்கள்.", "The district’s 2018 general page and 2025 boat-house page provide context. Their dates do not establish today’s services.");
---
<section id={sec(locale, 'history')} class="bg-[#eaf4ee] py-16 md:py-24">
  <div class="container-shell">
    <p class="kicker">{kicker}</p>
    <h2 class="section-title mt-3">{heading}</h2>
    <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {blocks.map((b) => (
        <article class="card p-6">
          <div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#0d6d70]/10 text-2xl" aria-hidden="true">{b.icon}</span><h3 class="text-lg font-black leading-snug text-[#0b4148]">{b.title}</h3></div>
          <p class="mt-4 text-sm leading-7 text-[#48605a]">{b.text}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-xs leading-6 text-[#5b706a]">{footnote}</p>
  </div>
</section>
