---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
// Condition-based visit planning, not measured climate normals or a forecast.
// Check actual weather, access and boat-service notices before travelling.
const seasonsTa = [
  {
    "icon": "🌤️",
    "title": "வெப்பம் மற்றும் வெயில்",
    "temp": "தற்போதைய வெப்பநிலை மற்றும் UV",
    "weather": "மாத சராசரியல்லாமல் தேதியுள்ள முன்னறிவிப்புக்கேற்ப உடை தேர்ந்தெடுங்கள்.",
    "water": "மழை மட்டும் ஏரி நீர்மட்டம் அல்லது படகு கிடைப்பை உறுதி செய்யாது.",
    "wildlife": "விலங்குகளைக் கண்டால் உணவளிக்காமல் அமைதியாகப் பாருங்கள்.",
    "tip": "மேகம் இருந்தாலும் தண்ணீர் மற்றும் வெயில் பாதுகாப்பு வையுங்கள்."
  },
  {
    "icon": "🌧️",
    "title": "மழை அல்லது இடி மழை",
    "temp": "அதிகாரப்பூர்வ எச்சரிக்கை மற்றும் மாடல்",
    "weather": "ஈரப்பாதை, படி மற்றும் சாலைத் தெளிவை உள்ளூரில் மதிப்பிடுங்கள்.",
    "water": "படகு அறிவுரையை நேரடியாகக் கேளுங்கள்; முன்னறிவிப்பு இயக்க அறிவிப்பு அல்ல.",
    "wildlife": "அனுமதிக்கப்பட்ட பாதையில் இருங்கள்; புகைப்படத்திற்காகச் செடிகளுக்குள் செல்லாதீர்கள்.",
    "tip": "இடி மழையில் உறுதியான கட்டிடத்தில் தஞ்சம் புகுங்கள்."
  },
  {
    "icon": "🍃",
    "title": "மூடுபனி அல்லது குறைந்த பார்வை",
    "temp": "தற்போதைய உள்ளூர் நிலை",
    "weather": "பார்வைத் தெளிவுக்கேற்ப மலைச் சாலை மற்றும் காட்சிமுனையை மாற்றுங்கள்.",
    "water": "அமைதியான நீரோ படகிற்கான அனுமதியோ இருப்பதாகக் கருதாதீர்கள்.",
    "wildlife": "விலங்குகளைத் தொந்தரவு செய்யாமல் தூரம் வையுங்கள்.",
    "tip": "கூடுதல் நேரம் அல்லது குறுகிய திட்டம் வையுங்கள்."
  },
  {
    "icon": "❄️",
    "title": "குளிரான நேரம்",
    "temp": "தற்போதைய வெப்பநிலை மற்றும் காற்று",
    "weather": "தேவைப்பட்டால் மேலாடை வையுங்கள்; தேதி மட்டும் சுகமான நிலைக்கு உறுதி அல்ல.",
    "water": "தற்போதைய படகேறும் மற்றும் வானிலை விதியைக் கேளுங்கள்.",
    "wildlife": "உள்ளூர் அறிவிப்பை மதித்து குப்பையை ஏரியில் போடாதீர்கள்.",
    "tip": "உங்கள் குழு மற்றும் அனுமதி நேரத்திற்கேற்ப நடையை மாற்றுங்கள்."
  }
];
const seasonsEn = [
  {
    "icon": "🌤️",
    "title": "Heat and sun",
    "temp": "Current temperature and UV",
    "weather": "Choose clothing from the dated forecast, not a monthly average.",
    "water": "Rainfall alone does not establish lake level or boat availability.",
    "wildlife": "Observe any wildlife quietly without feeding.",
    "tip": "Carry water and sun protection, even under cloud."
  },
  {
    "icon": "🌧️",
    "title": "Rain or thunderstorms",
    "temp": "Official warnings and current model",
    "weather": "Wet paths, steps and road visibility need local assessment.",
    "water": "Confirm boat instructions directly; a forecast is not an operating notice.",
    "wildlife": "Stay on permitted paths; do not enter vegetation for photos.",
    "tip": "Seek substantial shelter in thunderstorms."
  },
  {
    "icon": "🍃",
    "title": "Fog or poor visibility",
    "temp": "Current local conditions",
    "weather": "Adjust hill-road travel and viewpoints to actual visibility.",
    "water": "Do not infer calm water or permission to boat.",
    "wildlife": "Keep distance and avoid disturbing animals.",
    "tip": "Leave more time or choose a shorter plan."
  },
  {
    "icon": "❄️",
    "title": "Cooler periods",
    "temp": "Current temperature and wind",
    "weather": "Bring a layer when needed; dates alone do not guarantee comfort.",
    "water": "Ask about current boarding and weather rules.",
    "wildlife": "Follow local signs and keep litter out of the lake.",
    "tip": "Adapt the walk to your group and permitted hours."
  }
];
const strategyTa = [
  [
    "படகு சவாரி",
    "தற்போதைய படகு இல்ல உறுதி மற்றும் விதிகள்"
  ],
  [
    "அருவிப் பயணம்",
    "தற்போதைய அணுகல், பாதை நிலை மற்றும் எச்சரிக்கை"
  ],
  [
    "புகைப்படம் மற்றும் காட்சிமுனை",
    "அனுமதிக்கப்பட்ட அணுகல், உண்மையான தெளிவு மற்றும் வெளிச்சம்"
  ],
  [
    "குடும்பம் அல்லது எளிய நடை",
    "குழுவின் தேவை, பயன்படுத்தக்கூடிய பாதை மற்றும் ஓய்வு"
  ]
];
const strategyEn = [
  [
    "Boating",
    "Current boat-house confirmation and staff rules"
  ],
  [
    "Waterfall trip",
    "Current access, trail conditions and official warnings"
  ],
  [
    "Photos and viewpoints",
    "Permitted access, actual visibility and suitable light"
  ],
  [
    "Family or easier walk",
    "Your group’s needs, usable surfaces and rest"
  ]
];
const seasons = locale === 'en' ? seasonsEn : seasonsTa;
const strategy = locale === 'en' ? strategyEn : strategyTa;
const kicker = pick(locale, 'பருவ வியூகம்', 'Seasonal strategy');
const heading = pick(locale, "உண்மையான வானிலைக்கேற்ப பயணத் திட்டம்", "Plan around actual weather");
const intro = pick(locale, "கீழே உள்ளவை சாத்தியமான நிலைகளுக்கான நடைமுறைத் தயாரிப்பு; அளவிடப்பட்ட பருவ சராசரியோ நீர்மட்ட முன்னறிவிப்போ அல்ல.", "These are practical responses to possible conditions, not measured seasonal averages or lake-level forecasts.");
const lWeather = pick(locale, 'வானிலை', 'Weather');
const lWater = pick(locale, 'நீர் & ஏரி', 'Water & lake');
const lWildlife = pick(locale, 'வனவிலங்குகள்', 'Wildlife');
const recH = pick(locale, 'பருவ வாரியான பரிந்துரை', 'Seasonal recommendation');
const bestH = pick(locale, 'சாதகமான காலம்', 'Best time');
---
<section id={sec(locale, 'season')} class="bg-[#eaf4ee] py-16 md:py-24">
  <div class="container-shell">
    <p class="kicker">{kicker}</p>
    <h2 class="section-title mt-3">{heading}</h2>
    <p class="mt-4 max-w-3xl text-sm leading-7 text-[#48605a]" set:html={intro}></p>

    <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {seasons.map((s) => (
        <article class="card flex flex-col p-6">
          <div class="flex items-center justify-between gap-2"><span class="text-3xl" aria-hidden="true">{s.icon}</span><span class="rounded-full bg-[#0d6d70]/10 px-3 py-1 text-xs font-black text-[#0d6d70]">{s.temp}</span></div>
          <h3 class="mt-4 text-lg font-black text-[#0b4148]">{s.title}</h3>
          <dl class="mt-3 space-y-3 text-sm leading-7 text-[#48605a]">
            <div><dt class="font-extrabold text-[#0b4148]">{lWeather}</dt><dd>{s.weather}</dd></div>
            <div><dt class="font-extrabold text-[#0b4148]">{lWater}</dt><dd>{s.water}</dd></div>
            <div><dt class="font-extrabold text-[#0b4148]">{lWildlife}</dt><dd>{s.wildlife}</dd></div>
          </dl>
          <p class="mt-4 rounded-2xl bg-white/70 px-4 py-3 text-xs leading-6 text-[#35504a]">💡 {s.tip}</p>
        </article>
      ))}
    </div>

    <div class="card mt-8 overflow-hidden">
      <div class="grid gap-px bg-[#0d6d70]/10 sm:grid-cols-2">
        <div class="bg-[#fffdf8] p-5"><h3 class="text-base font-black text-[#0b4148]">{recH}</h3></div>
        <div class="bg-[#fffdf8] p-5"><h3 class="text-base font-black text-[#0b4148]">{bestH}</h3></div>
        {strategy.map(([k, v]) => (
          <>
            <div class="bg-[#fffdf8] px-5 py-3 text-sm font-bold text-[#0b4148]">{k}</div>
            <div class="bg-[#fffdf8] px-5 py-3 text-sm text-[#48605a]">{v}</div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
