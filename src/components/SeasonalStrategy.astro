---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
// Seasonal travel strategy for Yercaud — based on India Meteorological Department (IMD)
// 30-year average climate normals. Climatology, not a forecast; verify locally before travel.
const seasonsTa = [
  {
    icon: '🌤️', title: 'கோடை (மார்ச்–மே)',
    temp: '≈ 15–28°C',
    weather: 'சமவெளிகள் வெப்பமாக இருக்கும்போதும் ஏற்காடு தட்பவெப்ப நிலையில் மிதமானது; காலை & மாலை ஏரிக்கரை நடைக்கு ஏற்றது.',
    water: 'ஏரியின் நீர்மட்டம் மிதமானது; படகு இயக்கம் பொதுவாக சீராக உள்ளது.',
    wildlife: 'பறவைகள் சுறுசுறுப்பாகக் காணப்படும்; மழைக் கால அளவுக்கு ஈரப்பசை (leeches) அரிது.',
    tip: 'முன்-பருவமழை மழைத்தூறல்கள் அவ்வப்போது வரலாம்; படகுக்கு முன் வானிலையை உறுதிப்படுத்தவும்.'
  },
  {
    icon: '🌧️', title: 'தென்மேற்குப் பருவமழை (ஜூன்–செப்)',
    temp: '≈ 16–24°C',
    weather: 'தென்மேற்குப் பருவமழை கனமானது; மலை பசுமையாகவும் மூடுபனியுடனும் இருக்கும்; மலைச்சாலைகள் வழுக்கும்.',
    water: 'ஏரி நிரம்பியிருக்கும்; கிளியூர் அருவி உச்சக் காட்சியை அளிக்கும்.',
    wildlife: 'தாவர & விலங்கினச் செழிப்பு அதிகம்; ஈரப்பசை (leeches) பாதைகளில் இருக்கலாம்.',
    tip: 'படகு இயக்கம் காலநிலைக்கேற்ப நிறுத்தப்படலாம்; மழைக்கோடு & இழுப்படிகளுடன் வாருங்கள்.'
  },
  {
    icon: '🍃', title: 'வடகிழக்குப் பருவமழை / பின் மழை (அக்–நவ)',
    temp: '≈ 14–25°C',
    weather: 'வடகிழக்குப் பருவமழை லேசான சாரல்களுடன்; மழைக்குப் பிறகு வானம் தெளிவாக, ஒளி புகைப்படத்திற்கு ஏற்றது.',
    water: 'ஏரி நிலையானது; பசுமை தொடர்கிறது.',
    wildlife: 'பறவைகள் & பட்டாம்பூச்சிகள் சால்பான காலம்.',
    tip: 'காட்சிப் புகைப்படம் & குடும்பப் பயணத்திற்கு ஏற்ற பருவம்.'
  },
  {
    icon: '❄️', title: 'குளிர்காலம் (டிச–பிப்)',
    temp: '≈ 10–22°C',
    weather: 'ஆண்டின் குளிரான, தெளிவான காலம்; காலை மூடுபனி & இதமான பகல் — உச்சக் கூட்டம் நேரம்.',
    water: 'ஏரி அமைதியாக, படகு இயக்கம் சௌகரியமானது.',
    wildlife: 'தெளிவான காட்சிகள்; காலை பறவைகள் செயல்பாடு நன்றாக இருக்கும்.',
    tip: 'விடுமுறை நாட்களில் முன்கூட்டியே வாருங்கள்; காலைக் குளிருக்கு சால்பான ஆடைகள் பரிந்துரைக்கப்படுகின்றன.'
  }
];
const seasonsEn = [
  {
    icon: '🌤️', title: 'Summer (Mar–May)',
    temp: '≈ 15–28°C',
    weather: 'While the plains are hot, Yercaud’s climate is mild; good for lakeside walks in the morning & evening.',
    water: 'Lake level is moderate; boating usually runs steadily.',
    wildlife: 'Birds are active; leeches fewer than in the monsoon.',
    tip: 'Pre-monsoon showers may come occasionally; confirm weather before boating.'
  },
  {
    icon: '🌧️', title: 'Southwest Monsoon (Jun–Sep)',
    temp: '≈ 16–24°C',
    weather: 'Southwest monsoon is heavy; hills are green with fog; ghat roads are slippery.',
    water: 'Lake is full; Kiliyur Falls at its best.',
    wildlife: 'Rich plant & animal life; leeches may be on trails.',
    tip: 'Boating may stop with weather; come with raincoat & grip.'
  },
  {
    icon: '🍃', title: 'NE Monsoon / Post-rain (Oct–Nov)',
    temp: '≈ 14–25°C',
    weather: 'NE monsoon with light showers; after rain the sky clears, good for light photography.',
    water: 'Lake is stable; greenery continues.',
    wildlife: 'Good season for birds & butterflies.',
    tip: 'Good season for sightseeing & family trips.'
  },
  {
    icon: '❄️', title: 'Winter (Dec–Feb)',
    temp: '≈ 10–22°C',
    weather: 'The year’s coolest, clearest season; morning fog & pleasant days — peak crowd time.',
    water: 'Lake is calm, boating comfortable.',
    wildlife: 'Clear views; good morning bird activity.',
    tip: 'Come early on holidays; warm layers advised for the morning chill.'
  }
];
const strategyTa = [
  ['படகு & ஏரிக்கரை நடை', 'அக்–மார்ச் (பின் மழை → கோடை → குளிர்காலம் ஆரம்பம்)'],
  ['கிளியூர் அருவி உச்சக் காட்சி', 'ஜூலை–செப் (பருவமழை உச்சம்)'],
  ['புகைப்படம் & காட்சிகள்', 'நவ–பிப் (தெளிவான வானம், மூடுபனி அழகு)'],
  ['குடும்பம் / முதல் முறை பயணம்', 'டிச–பிப் & அக்–நவ (வசதியான தட்பவெப்பம்)']
];
const strategyEn = [
  ['Boat & lakeside walk', 'Oct–Mar (post-rain → summer → early winter)'],
  ['Kiliyur Falls peak', 'Jul–Sep (monsoon peak)'],
  ['Photos & views', 'Nov–Feb (clear sky, fog beauty)'],
  ['Family / first-time', 'Dec–Feb & Oct–Nov (comfortable climate)']
];
const seasons = locale === 'en' ? seasonsEn : seasonsTa;
const strategy = locale === 'en' ? strategyEn : strategyTa;
const kicker = pick(locale, 'பருவ வியூகம்', 'Seasonal strategy');
const heading = pick(locale, 'எந்தப் பருவங்களில் ஏற்காட்டைப் பார்ப்பது?', 'Which seasons to visit Yercaud?');
const intro = pick(locale,
  'கீழே உள்ளவை <strong class="text-[#0b4148]">இந்திய வானிலை ஆய்வு மையத்தின் (IMD) 30 ஆண்டு சராசரி காலநிலை புள்ளிவிவரங்களின்</strong> அடிப்படையிலான பருவக்கோட்பாடு (climatology) — இது நிகழ்நேர வானிலை முன்னறிவிப்பு அல்ல. நீர், வனவிலங்குகள் மற்றும் மலைச்சாலை நிலை பயண நாளில் மாறலாம்.',
  'The following is climatology based on the <strong class="text-[#0b4148]">India Meteorological Department (IMD) 30-year average climate normals</strong> — not a live forecast. Water, wildlife and ghat-road conditions can change on the day of travel.');
const lWeather = pick(locale, 'வானிலை', 'Weather');
const lWater = pick(locale, 'நீர் & ஏரி', 'Water & lake');
const lWildlife = pick(locale, 'வனவிலங்குகள்', 'Wildlife');
const recH = pick(locale, 'பருவ வாரியான பரிந்துரை', 'Seasonal recommendation');
const bestH = pick(locale, 'சாதகமான காலம்', 'Best time');
---
<section id={sec(locale, 'season')} class="bg-[#eaf4ee] py-16 md:py-24">
  <div class="container-shell">
    <p class="kicker">{kicker}</p>
    <h2 class="section-title mt-3">{heading}</h2>
    <p class="mt-4 max-w-3xl text-sm leading-7 text-[#48605a]" set:html={intro}></p>

    <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {seasons.map((s) => (
        <article class="card flex flex-col p-6">
          <div class="flex items-center justify-between gap-2"><span class="text-3xl" aria-hidden="true">{s.icon}</span><span class="rounded-full bg-[#0d6d70]/10 px-3 py-1 text-xs font-black text-[#0d6d70]">{s.temp}</span></div>
          <h3 class="mt-4 text-lg font-black text-[#0b4148]">{s.title}</h3>
          <dl class="mt-3 space-y-3 text-sm leading-7 text-[#48605a]">
            <div><dt class="font-extrabold text-[#0b4148]">{lWeather}</dt><dd>{s.weather}</dd></div>
            <div><dt class="font-extrabold text-[#0b4148]">{lWater}</dt><dd>{s.water}</dd></div>
            <div><dt class="font-extrabold text-[#0b4148]">{lWildlife}</dt><dd>{s.wildlife}</dd></div>
          </dl>
          <p class="mt-4 rounded-2xl bg-white/70 px-4 py-3 text-xs leading-6 text-[#35504a]">💡 {s.tip}</p>
        </article>
      ))}
    </div>

    <div class="card mt-8 overflow-hidden">
      <div class="grid gap-px bg-[#0d6d70]/10 sm:grid-cols-2">
        <div class="bg-[#fffdf8] p-5"><h3 class="text-base font-black text-[#0b4148]">{recH}</h3></div>
        <div class="bg-[#fffdf8] p-5"><h3 class="text-base font-black text-[#0b4148]">{bestH}</h3></div>
        {strategy.map(([k, v]) => (
          <>
            <div class="bg-[#fffdf8] px-5 py-3 text-sm font-bold text-[#0b4148]">{k}</div>
            <div class="bg-[#fffdf8] px-5 py-3 text-sm text-[#48605a]">{v}</div>
          </>
        ))}
      </div>
    </div>
  </div>
</section>
