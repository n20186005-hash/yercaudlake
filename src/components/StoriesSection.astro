---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
const storiesTa = [
  {
    "badge": "பயணப் பின்னணி",
    "badgeClass": "bg-[#f4d98d]/90 text-[#4a3410]",
    "title": "வேறு பெயர்கள், ஒரே இடம்",
    "text": "வருகையைத் திட்டமிடும்போது சரியான ஏற்காடு வரைபடத்தைப் பயன்படுத்துங்கள். பொதுவான ஏரிப் பெயர் மட்டும் வேறு நகரின் இடத்தை அடையாளம் காணப் போதாது."
  },
  {
    "badge": "பயணப் பின்னணி",
    "badgeClass": "bg-[#cde9d8] text-[#143d2c]",
    "title": "புகைப்படமும் மாற்றமும்",
    "text": "படம் ஒரு குறிப்பிட்ட வருகையைப் பதிவு செய்கிறது. பழைய காட்சி இன்றைய நீர்மட்டம், அணுகல், படகு வகை அல்லது நேரத்தை உறுதி செய்யாது."
  },
  {
    "badge": "பயணப் பின்னணி",
    "badgeClass": "bg-[#e3d9f2] text-[#3a2a5c]",
    "title": "ஏரியும் பூங்காவும்",
    "text": "அண்ணா பூங்கா அருகில் இருந்தாலும் அதன் நுழைவு மற்றும் நேரத்தைத் தனியாக உறுதிப்படுத்திச் சேருங்கள்."
  },
  {
    "badge": "பயணப் பின்னணி",
    "badgeClass": "bg-[#f6d9d3] text-[#5c2418]",
    "title": "மூன்று படகு வகைகள்",
    "text": "மாவட்டத்தின் தேதியுள்ள படகு இல்லப் பக்கம் மிதி, துடுப்பு மற்றும் இயந்திரப் படகுகளை வேறுபடுத்துகிறது. இன்று கிடைப்பது, பயணி எண்ணிக்கை மற்றும் பாதுகாப்பு விதியைக் கேளுங்கள்."
  },
  {
    "badge": "பயணப் பின்னணி",
    "badgeClass": "bg-[#cde9ec] text-[#123c44]",
    "title": "அருவி ஒரு தனித் திட்டம்",
    "text": "கிளியூர் அருவிக்குப் புறப்படுமுன் தற்போதைய அணுகல் மற்றும் நிலையைச் சரிபாருங்கள். முன்னறிவிப்பு மழை அழகான நீர்வரத்து அல்லது பாதுகாப்பான திறந்த வழிக்கு உறுதி அல்ல."
  }
];
const storiesEn = [
  {
    "badge": "Visitor context",
    "badgeClass": "bg-[#f4d98d]/90 text-[#4a3410]",
    "title": "Different names, one destination",
    "text": "Use the exact Yercaud place map when planning arrival. A familiar lake name is not enough to identify another town’s destination."
  },
  {
    "badge": "Visitor context",
    "badgeClass": "bg-[#cde9d8] text-[#143d2c]",
    "title": "Photographs and change",
    "text": "Photographs record a particular visit. Older scenes do not prove today’s water level, access, boat types or operating hours."
  },
  {
    "badge": "Visitor context",
    "badgeClass": "bg-[#e3d9f2] text-[#3a2a5c]",
    "title": "Lake and garden visits",
    "text": "Anna Park is close to the lake, but confirm its own entry and hours before adding it to a lake visit."
  },
  {
    "badge": "Visitor context",
    "badgeClass": "bg-[#f6d9d3] text-[#5c2418]",
    "title": "Three kinds of boats",
    "text": "The district’s dated boat-house page distinguishes pedal, rowing and motor boats. Ask which are available and what capacity and safety rules apply today."
  },
  {
    "badge": "Visitor context",
    "badgeClass": "bg-[#cde9ec] text-[#123c44]",
    "title": "A waterfall is a separate plan",
    "text": "Check current Kiliyur Falls access and conditions before setting out. Rain in a forecast does not guarantee an attractive flow or a safe open route."
  }
];
const stories = locale === 'en' ? storiesEn : storiesTa;
const badgeBase = 'inline-block rounded-full px-3 py-1 text-xs font-black';
const kicker = pick(locale, 'கதைகள் & நினைவுகள்', 'Stories & memories');
const heading = pick(locale, 'ஏரியின் பெயர்களும் உள்ளூர் நினைவுகளும்', 'The lake’s names & local memories');
const intro = pick(locale, "ஏரியின் பெயர், புகைப்படங்களில் தெரியும் காட்சி மற்றும் சுற்றுப்புறப் பயணத்தைப் புரிந்துகொள்ள உதவும் குறிப்புகள்.", "Explore the lake’s names, what photographs show, and how a garden or waterfall visit relates to the lake.");
---
<section id={sec(locale, 'stories')} class="container-shell py-16 md:py-24">
  <p class="kicker">{kicker}</p>
  <h2 class="section-title mt-3">{heading}</h2>
  <p class="mt-4 max-w-3xl text-sm leading-7 text-[#48605a]">{intro}</p>
  <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {stories.map((s) => (
      <article class="card flex flex-col p-6">
        <span class={badgeBase + ' ' + s.badgeClass}>{s.badge}</span>
        <h3 class="mt-4 text-lg font-black leading-snug text-[#0b4148]">{s.title}</h3>
        <p class="mt-3 text-sm leading-7 text-[#48605a]">{s.text}</p>
      </article>
    ))}
  </div>
</section>
