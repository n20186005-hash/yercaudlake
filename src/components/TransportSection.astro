---
import { type Locale, sec, pick } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ta' } = Astro.props;
// How to reach Yercaud Lake & Boat House — neutral, type-based guidance only (no commercial names).
const modesTa = [
  {
    "icon": "✈️",
    "title": "விமானம் (Air)",
    "steps": [
      "தற்போதைய முன்பதிவு விமானத்தை வைத்து விமான நிலையம் தேர்ந்தெடுத்து ஏற்காடு சாலை வழியைச் சரிபாருங்கள்.",
      "அடுத்த போக்குவரத்து, விலை மற்றும் சந்திக்கும் இடத்தை வழங்குநரிடம் உறுதி செய்யுங்கள்.",
      "மலைச் சாலை நிலைக்கு நேரம் ஒதுக்குங்கள்; இங்கு நிலையான பயணநேர உறுதி இல்லை."
    ]
  },
  {
    "icon": "🚆",
    "title": "ரயில் (Rail)",
    "steps": [
      "மாவட்டம் சேலம் சந்திப்பை ரயில் அணுகலாகக் குறிப்பிடுகிறது; அதன் 2018 பக்கம் சுமார் 35 கிமீ எனக் கூறுகிறது.",
      "தற்போதைய ரயிலும் வந்திறங்கும் நிலையத்திலிருந்து அடுத்த வழியையும் சரிபாருங்கள்.",
      "நிலைய நுழைவிலிருந்து நேரடிப் பேருந்து இருப்பதாகக் கருதாதீர்கள்."
    ]
  },
  {
    "icon": "🚌",
    "title": "பேருந்து (Bus)",
    "steps": [
      "சேலம் மற்றும் ஏற்காடு இடையிலான பேருந்து இணைப்பை மாவட்டம் குறிப்பிடுகிறது.",
      "தற்போதைய இயக்குநர் நேரம், ஏறும் இடம் மற்றும் இணைப்பைச் சரிபாருங்கள்.",
      "நிறுத்தத்திலிருந்து படகு இல்லம் செல்லும் இறுதி வழியை உறுதி செய்யுங்கள்; எல்லா நகரிலிருந்தும் நேரடிச் சேவை இருப்பதாகக் கருதாதீர்கள்."
    ]
  },
  {
    "icon": "🚕",
    "title": "டாக்சி / கேப் (Taxi / Cab)",
    "steps": [
      "வழங்குநர், விலை மற்றும் உண்மையான ஏறும் இடத்தை உறுதி செய்தபின் முன்பதிவு செய்யுங்கள்.",
      "அனுமதிக்கப்பட்ட ஏரிப் பகுதி இறங்கும் இடம் மற்றும் திரும்பச் சந்திக்கும் இடத்தைத் தீர்மானியுங்கள்.",
      "இந்த வழிகாட்டி கிடைப்பை உறுதி செய்யாது."
    ]
  },
  {
    "icon": "🛺",
    "title": "உள்ளூர் போக்குவரத்து (Local)",
    "steps": [
      "பகிர்வுச் சேவை இருப்பதாகக் கருதாமல் அன்றைய உள்ளூர் போக்குவரத்தைச் சரிபாருங்கள்.",
      "அண்ணா பூங்கா அருகில் உள்ளது; நடக்குமுன் பாதை, கடத்தல் மற்றும் அணுகலை உறுதி செய்யுங்கள்.",
      "காட்சிமுனை மற்றும் அருவியைத் தனியான பயணமாக, தனி அணுகல் சரிபார்ப்புடன் கருதுங்கள்."
    ]
  },
  {
    "icon": "🚗",
    "title": "சொந்த வாகனம் (Driving)",
    "steps": [
      "மலை ஏறும் முன் தற்போதைய வழி, சாலைக் கட்டுப்பாடு மற்றும் தெளிவைப் பாருங்கள்.",
      "எரிபொருள் அல்லது சார்ஜிங்கை வழங்குநரின் தற்போதைய தகவலால் திட்டமிடுங்கள்.",
      "மழை அல்லது மூடுபனியில் கவனமாக ஓட்டி அறிவிப்பையும் அனுமதிக்கப்பட்ட நிறுத்த விதியையும் பின்பற்றுங்கள்."
    ]
  }
];
const modesEn = [
  {
    "icon": "✈️",
    "title": "Flight (Air)",
    "steps": [
      "Choose an airport using current booked flights, then check the actual road route to Yercaud.",
      "Confirm onward transport, price and meeting place with the provider.",
      "Allow for ghat-road conditions; fixed journey times are not guaranteed here."
    ]
  },
  {
    "icon": "🚆",
    "title": "Train (Rail)",
    "steps": [
      "The district lists Salem Junction as the rail approach; its 2018 page gives about 35 km.",
      "Check current train services and the onward route from your arrival station.",
      "Do not assume a direct bus leaves from the station entrance."
    ]
  },
  {
    "icon": "🚌",
    "title": "Bus",
    "steps": [
      "The district describes bus links between Salem and Yercaud.",
      "Check the current operator timetable, boarding point and any connection.",
      "Confirm the final route from the stop to the boat house; do not assume a direct service from every city."
    ]
  },
  {
    "icon": "🚕",
    "title": "Taxi / Cab",
    "steps": [
      "Book only after confirming the provider, fare and actual pickup.",
      "Agree a permitted lake-area drop-off and return meeting point.",
      "Availability is not guaranteed by this guide."
    ]
  },
  {
    "icon": "🛺",
    "title": "Local transport",
    "steps": [
      "Check available local transport on the day rather than assuming a shared service.",
      "Anna Park is nearby; confirm surfaces, crossings and access before planning a walk.",
      "Treat viewpoints and waterfalls as separate journeys with their own access checks."
    ]
  },
  {
    "icon": "🚗",
    "title": "Driving",
    "steps": [
      "Check the current route, road restrictions and visibility before climbing.",
      "Arrange fuel or charging using current provider information.",
      "Drive cautiously in rain or fog; follow signs and authorised parking rules."
    ]
  }
];
const modes = locale === 'en' ? modesEn : modesTa;
const kicker = pick(locale, 'விரிவான போக்குவரத்து', 'Getting here');
const heading = pick(locale, 'ஏற்காட்டை அடைய — விமானம், ரயில், பேருந்து, டாக்சி', 'Reaching Yercaud — flight, train, bus, taxi');
const intro = pick(locale,
  'ஏற்காடு சேலம் மாவட்டத்தின் செவராய் மலைப்பகுதியில் அமைந்துள்ளது. கீழே ஒவ்வொரு பயண முறைக்குமான படிநிலை வழிகாட்டி உள்ளது; விலை & நேரம் பருவத்திற்கேற்ப மாறலாம், பயண நாளில் உறுதிப்படுத்தவும்.',
  'Yercaud is in the Shevaroy Hills of Salem district. Step-by-step guidance for each travel mode is below; fare & time vary by season, so confirm on the day of travel.');
const mapTitle = pick(locale, 'ஏற்காடு ஏரி மற்றும் படகு இல்லம் கூகுள் வரைபடம்', 'Google Maps of Yercaud Lake & Boat House');
const mapNote = pick(locale, "இது குறிப்பிட்ட ஏற்காடு இடத்திற்கான மூன்றாம் தரப்பு வரைபடம். தற்போதைய நுழைவு, நிறுத்தம், சாலை மற்றும் படகேற்ற வழியைத் தனியாக உறுதி செய்யுங்கள்.", "This third-party map identifies the Yercaud place. Confirm current entry, parking, road access and boarding separately.");
---
<section id={sec(locale, 'transport')} class="container-shell py-16 md:py-24">
  <p class="kicker">{kicker}</p>
  <h2 class="section-title mt-3">{heading}</h2>
  <p class="mt-4 max-w-3xl text-sm leading-7 text-[#48605a]">{intro}</p>

  <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {modes.map((m) => (
      <article class="card p-6">
        <div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-[#0d6d70]/10 text-2xl" aria-hidden="true">{m.icon}</span><h3 class="text-lg font-black leading-snug text-[#0b4148]">{m.title}</h3></div>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-[#48605a]">
          {m.steps.map((s) => <li class="flex gap-2"><span class="mt-2 text-[#0d6d70]">▪</span><span>{s}</span></li>)}
        </ul>
      </article>
    ))}
  </div>

  <div id={sec(locale, 'map')} class="mt-10 card overflow-hidden p-2">
    <iframe title={mapTitle} src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6946.906779668292!2d78.20567047699069!3d11.784194188432547!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3babf5d3fdbf5969%3A0x396bdfd64ac28543!2sYercaud%20Lake%20%26%20Boat%20House%20(Emerald%20Lake)!5e1!3m2!1sta!2sin!4v1788421263897!5m2!1sta!2sin" width="100%" height="520" style="border:0;border-radius:1.15rem" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <p class="mt-3 text-xs leading-6 text-[#5b706a]">{mapNote}</p>
</section>
