---
import {getWeather,renderCurrent,renderDays,buildAdvice,renderAdvice} from '../lib/weather';
import {type Locale,sec} from '../i18n';
interface Props {locale?:Locale}
const {locale='ta'}=Astro.props,en=locale==='en',init=await getWeather();
const unavailable=en?'Weather data is unavailable. Check a current official forecast.':'வானிலைத் தகவல் கிடைக்கவில்லை. தற்போதைய அதிகாரப்பூர்வ முன்னறிவிப்பைப் பார்க்கவும்.';
---
<section id={sec(locale,'weather')} class="relative bg-[#0b4148] py-16 text-white md:py-22">
<div class="container-shell">
<p class="text-xs font-black tracking-[.12em] text-[#b8e0cc]">{en?'Weather model':'வானிலை மாடல்'}</p>
<h2 class="mt-3 text-3xl font-black sm:text-5xl">{en?'Yercaud — now and seven days':'ஏற்காடு — இப்போது மற்றும் ஏழு நாட்கள்'}</h2>
<p class="mt-4 max-w-3xl text-sm leading-7 text-white/72">{en?'Open-Meteo model for the lake area, not an on-site measurement. Use it for clothing and breaks; confirm boating and route access with staff.':'ஏரிப் பகுதிக்கான Open-Meteo மாடல்; இடத்திலுள்ள நேரடி அளவீடு அல்ல. உடை மற்றும் ஓய்வுக்குப் பயன்படுத்துங்கள்; படகு மற்றும் பாதை அணுகலைப் பணியாளரிடம் உறுதி செய்யுங்கள்.'}</p>
<div class="mt-8 grid min-w-0 gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)]">
<div id="wx-current" class="min-w-0 rounded-3xl bg-white/10 p-6 ring-1 ring-white/15 backdrop-blur" set:html={init?renderCurrent(init,locale):`<p>${unavailable}</p>`}></div>
<div id="wx-days" class="grid min-w-0 grid-cols-2 gap-3 sm:grid-cols-3" set:html={init?renderDays(init,locale):''}></div>
</div>
<div id="wx-advice" class="mt-8 min-w-0" set:html={init?renderAdvice(buildAdvice(init,locale)):''}></div>
<p id="wx-note" class="mt-4 text-xs text-white/60">{init?(en?'Provider time: ':'முன்னறிவிப்பு நேரம்: ')+init.current.time.replace('T',' ')+' · Asia/Kolkata (UTC+5:30)':unavailable}</p>
<noscript><p class="mt-3 text-xs">{en?'Without JavaScript a dated build snapshot cannot refresh. Check a current forecast.':'JavaScript இல்லாமல் தேதியுள்ள கட்டுமானப் பதிவு புதுப்பிக்காது. தற்போதைய முன்னறிவிப்பைப் பார்க்கவும்.'}</p></noscript>
</div>
<script is:inline type="application/json" id="weather-init" set:html={JSON.stringify(init).replace(/</g,'\\u003c')}></script>
</section>
<script>import {initWeather} from '../lib/weather-client';initWeather();</script>
<style>#wx-current,#wx-days,#wx-advice,#wx-days>* {min-width:0;overflow-wrap:anywhere;}</style>
