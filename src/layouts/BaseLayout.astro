---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieAnalytics from '../components/CookieAnalytics.astro';
import '../styles/global.css';
interface Props { title: string; description: string; image?: string; imageAlt?: string; noindex?: boolean; jsonLd?: object | object[] }
const { title, description, image, imageAlt, noindex = false, jsonLd } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
const ogImageAlt = imageAlt || title;
---
<!doctype html>
<html lang="ta-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0d6d70" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ஏற்காடு ஏரி &amp; படகு இல்லம் — Yercaud Lake Visitor Guide" />
    <meta property="og:locale" content="ta_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <CookieAnalytics />
    <script is:inline>
      (() => {
        const h = location.hostname;
        if (!('serviceWorker' in navigator)) return;
        if (h === 'localhost' || h === '127.0.0.1' || h === '::1') return;
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      })();
    </script>
  </head>
  <body>
    <a href="#முதன்மை" class="focus-ring fixed left-3 top-3 z-[100] -translate-y-24 rounded bg-white px-4 py-2 font-bold shadow focus:translate-y-0">முதன்மை உள்ளடக்கத்திற்குச் செல்லவும்</a>
    <Header />
    <main id="முதன்மை"><slot /></main>
    <Footer />
  </body>
</html>
