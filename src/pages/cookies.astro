import LegalLayout from '../layouts/LegalLayout.astro';
---
<LegalLayout title="குக்கீ அமைப்புகள் | ஏற்காடு ஏரி & படகு இல்லம், ஏற்காடு — பயண வழிகாட்டி" description="அத்தியாவசிய, பகுப்பாய்வு, விருப்பம் மற்றும் சந்தைப்படுத்தல் குக்கீ அமைப்புகளை நிர்வகிக்கவும்." noindex>
<h1 class="section-title">குக்கீ அமைப்புகள்</h1><p class="mt-2 text-sm font-bold text-[#6a7b76]">கடைசியாக புதுப்பிக்கப்பட்டது: செப்டம்பர் 2026</p>
<p class="mt-7">உலாவல் அனுபவத்தை ஆதரிக்க குறைந்தபட்ச உள்ளூர் சேமிப்பை பயன்படுத்துகிறோம். உங்கள் விருப்பங்களை கீழே நிர்வகிக்கலாம்.</p>
<div class="mt-8 space-y-4">
  <section class="rounded-2xl border border-[#173d3b]/12 bg-[#f6f0df] p-5"><div class="flex items-center justify-between gap-4"><div><h2 class="!m-0 text-lg">அத்தியாவசிய குக்கீகள்</h2><p class="mt-2 text-sm">தளத்தின் அடிப்படை செயல்பாடு மற்றும் உங்கள் சம்மதத் தேர்வை நினைவில் வைக்க இவை தேவை.</p></div><span class="rounded-full bg-[#d9ebdf] px-3 py-1 text-xs font-black text-[#245d42]">எப்போதும் செயலில்</span></div></section>
  <section class="rounded-2xl border border-[#173d3b]/12 p-5"><label class="flex cursor-pointer items-start justify-between gap-4"><div><h2 class="!m-0 text-lg">பகுப்பாய்வு குக்கீகள்</h2><p class="mt-2 text-sm">பெயரில்லா பயன்பாட்டு முறைகளைப் புரிந்துகொள்ள உதவும். இயக்கப்பட்டால் மட்டும் கூகுள் அனலிட்டிக்ஸ் 4 (G-HXM22WWPKP) ஏற்றப்படும்.</p></div><input id="analytics" type="checkbox" class="mt-2 h-5 w-5"/></label></section>
  <section class="rounded-2xl border border-[#173d3b]/12 p-5"><label class="flex cursor-pointer items-start justify-between gap-4"><div><h2 class="!m-0 text-lg">விருப்ப குக்கீகள்</h2><p class="mt-2 text-sm">உங்கள் தள விருப்பங்களை நினைவில் வைக்க அனுமதிக்கிறது. தற்போதைய தளம் மொழி மாற்றியை வழங்காது; இந்த வகை எதிர்காலத் தள விருப்பங்களுக்கு மட்டுமே.</p></div><input id="preferences" type="checkbox" class="mt-2 h-5 w-5"/></label></section>
  <section class="rounded-2xl border border-[#173d3b]/12 bg-[#f7f7f4] p-5"><div class="flex items-center justify-between gap-4"><div><h2 class="!m-0 text-lg">சந்தைப்படுத்தல் குக்கீகள்</h2><p class="mt-2 text-sm">தனிப்பயன் விளம்பர கண்காணிப்பு இந்தத் திட்டத்தில் செயல்படுத்தப்படவில்லை.</p></div><span class="rounded-full bg-[#ece9e5] px-3 py-1 text-xs font-black text-[#6b625d]">முடக்கப்பட்டுள்ளது</span></div></section>
</div>
<h2>சம்மத மேலாண்மை</h2><p>உங்கள் தேர்வுகளை எப்போது வேண்டுமானாலும் மாற்றலாம். சில விருப்ப சேமிப்புகளை முடக்குவது எதிர்கால வசதிகளின் செயல்பாட்டை பாதிக்கலாம்.</p>
<div class="mt-6 flex flex-wrap gap-3"><button id="save" class="rounded-full bg-[#0d6d70] px-5 py-3 font-extrabold text-white">விருப்பங்களைச் சேமிக்கவும்</button><button id="reject" class="rounded-full border border-[#0d6d70]/25 px-5 py-3 font-extrabold text-[#0d6d70]">அனைத்தையும் நிராகரிக்கவும்</button></div><p id="status" class="mt-4 text-sm font-bold text-[#537a4c]" aria-live="polite"></p>
<script is:inline>
(()=>{const K='yercaud-cookie-consent',a=document.getElementById('analytics'),p=document.getElementById('preferences'),s=document.getElementById('status');try{const v=JSON.parse(localStorage.getItem(K)||'null');if(v){a.checked=!!v.analytics;p.checked=!!v.preferences}}catch{}const put=v=>{localStorage.setItem(K,JSON.stringify(v));window.dispatchEvent(new CustomEvent('yercaud-consent-updated',{detail:v}));s.textContent='உங்கள் தேர்வு சேமிக்கப்பட்டது.'};document.getElementById('save').addEventListener('click',()=>put({necessary:true,analytics:a.checked,preferences:p.checked,marketing:false}));document.getElementById('reject').addEventListener('click',()=>{a.checked=false;p.checked=false;put({necessary:true,analytics:false,preferences:false,marketing:false})})})();
</script>
</LegalLayout>
