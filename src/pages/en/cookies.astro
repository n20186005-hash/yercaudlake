---
import LegalLayout from "../../layouts/LegalLayout.astro";
---
<LegalLayout locale="en" title="Cookie settings | Yercaud Lake" description="Cookie settings" noindex><h1 class="section-title">Cookie settings</h1><p>Updated 25 October 2026</p><div class="mt-7 grid gap-4"><label class="card flex min-w-0 items-start justify-between gap-5 p-5"><span><strong>Essential storage</strong><br/>Needed for the site and remembering a choice.</span><input type="checkbox" checked disabled /></label><label class="card flex min-w-0 items-start justify-between gap-5 p-5"><span><strong>Analytics</strong><br/>Google Analytics loads only after a successfully verified saved allowance.</span><input id="analytics" type="checkbox"/></label><label class="card flex min-w-0 items-start justify-between gap-5 p-5"><span><strong>Preferences</strong><br/>Records this choice; it does not automatically restore a theme or language.</span><input id="preferences" type="checkbox"/></label><label class="card flex min-w-0 items-start justify-between gap-5 p-5"><span><strong>Marketing (not used)</strong><br/>No personalised advertising is operated by this project.</span><input type="checkbox" disabled /></label></div><p class="mt-6">Allowing may load analytics immediately. Withdrawal stops this page immediately, but cannot recall earlier requests. A failed save can leave an older choice for future pages; read the status message.</p><div class="mt-6 flex flex-wrap gap-3"><button id="save" class="rounded-full bg-[#0d6d70] px-5 py-3 font-bold text-white">Save choices</button><button id="reject" class="rounded-full border px-5 py-3 font-bold">Reject optional</button></div><p id="status" class="mt-4 font-bold" role="status" aria-live="polite"></p><script is:inline>
(()=>{const api=window.yercaudAnalytics,a=document.getElementById('analytics'),p=document.getElementById('preferences'),s=document.getElementById('status');if(!api||!a||!p||!s)return;a.checked=api.get();try{p.checked=JSON.parse(localStorage.getItem('yercaud-cookie-consent')||'{}').preferences===true;}catch{}let failed=false;const save=allow=>{const r=api.set(allow,p.checked);a.checked=r.effective;failed=!r.saved;s.textContent=r.saved?"Choice saved. Analytics may load immediately when allowed; withdrawal cannot recall earlier requests.":r.sharedOff?"Analytics is off on this page and shared refusal was verified, but the requested preferences were not saved.":"Analytics is off on this page. Saving failed; another page or future session may read an older choice. Retry or clear this site’s stored data.";};document.getElementById('save').addEventListener('click',()=>save(a.checked));document.getElementById('reject').addEventListener('click',()=>{p.checked=false;save(false);});window.addEventListener('storage',event=>{if(event.key==='yercaud-cookie-consent'||event.key===null){a.checked=api.get();if(!failed)s.textContent='';}});})();
</script></LegalLayout>