---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeatherSection from '../../components/WeatherSection.astro';
import FacilitiesSection from '../../components/FacilitiesSection.astro';
import HistorySection from '../../components/HistorySection.astro';
import StoriesSection from '../../components/StoriesSection.astro';
import GallerySection from '../../components/GallerySection.astro';
import SourcesSection from '../../components/SourcesSection.astro';
import TransportSection from '../../components/TransportSection.astro';
import SeasonalStrategy from '../../components/SeasonalStrategy.astro';
import Itineraries from '../../components/Itineraries.astro';
import VisitorResponsibility from '../../components/VisitorResponsibility.astro';
const title = 'Yercaud Lake & Boat House — Hours, Fare Context & Visit Planning';
const description = 'Plan Yercaud Lake (Emerald Lake) with dated hours, boat-fare background and what to confirm at the counter, plus directions, weather forecasts and nearby places.';
const pageUrl = Astro.site ? new URL('/en/', Astro.site).href : undefined;
const faq = [
  [
    "Which district is Yercaud in?",
    "Yercaud Lake and Boat House are in Salem District, Tamil Nadu, India — a hill station in the Shevaroy Hills."
  ],
  [
    "Is there a separate entry fee for the lake?",
    "No verified current lakeside admission policy was obtained. Do not assume that free lake access, boating and separate park admission are the same arrangement; ask locally."
  ],
  [
    "Where is Yercaud Lake located?",
    "The current Maps address is Lake To Ladies Seat Road, Yercaud, Tamil Nadu 636602. Use the exact place map; the point is 11.7841942,78.2082454."
  ],
  [
    "When is boating available?",
    "Google Maps listed 09:00–18:00 daily when checked 25 October 2026. The district general page dated 2018 lists 09:00–17:30 for boating. These differ in date and scope; confirm current boat-service hours, last tickets and interruptions at the boat house."
  ],
  [
    "What are the boating charges?",
    "Ask separately about lakeside access and a boat ticket. The district’s 2025 boat page gives different rates by type and capacity; it is not today’s confirmed offer. Ask which boats operate, ride duration, current total and any extras before paying."
  ],
  [
    "Can we go with children?",
    "Check age, boarding and capacity conditions for your group. Follow staff and properly fitted life-jacket instructions; availability is not guaranteed."
  ],
  [
    "Is parking available?",
    "Confirm permitted parking, price and the last walking section locally; no space is guaranteed."
  ],
  [
    "How much time to spend?",
    "A shorter visit might allow 1.5–2.5 hours as a planning estimate, depending on current access, queues, your pace and breaks. It does not guarantee boating or a complete circuit."
  ],
  [
    "Can you swim or bathe in the lake?",
    "Do not infer swimming or bathing permission from a boat service. Stay out of the water and follow current staff and safety instructions."
  ],
  [
    "What is it like on weekends / holidays?",
    "Allow flexible time for queues and local restrictions, and choose a shorter alternative if needed. An early arrival does not guarantee an available boat or parking space."
  ],
  [
    "Which seasons are best to visit Yercaud?",
    "Use current temperature, UV, rain, visibility and official warnings rather than a calendar guarantee. Rain does not establish lake level, a safe waterfall trail or boat availability."
  ],
  [
    "Are there stays or restaurants nearby?",
    "Check the actual address, opening, prices and booking terms of any chosen restaurant or stay. This guide is not a verified business directory."
  ],
  [
    "How to reach Yercaud Lake?",
    "The district describes Salem Junction and Salem–Yercaud bus links. Check current rail or bus services and the final road route from your actual arrival point; no fixed journey time or direct airport connection is promised."
  ]
];
const attractionId = Astro.site ? new URL('#attraction', Astro.site).href : undefined;
const attraction = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': attractionId,
  name: 'Yercaud Lake and Boat House (Emerald Lake)',
  alternateName: ['Yercaud Lake', 'Yercaud Lake & Boat House (Emerald Lake)', 'Yercaud Big Lake', 'Emerald Lake'],
  hasMap: 'https://maps.app.goo.gl/DnvJDBDKXe8s1Rmi9',

  ...(pageUrl ? { url: pageUrl } : {}),
  ...(pageUrl ? { image: ['images/yercaud-lake-panorama.jpg', 'images/yercaud-lake-boathouse.jpg', 'images/yercaud-lake-boating.jpg'].map((p) => new URL(p, pageUrl!).href) } : {}),
  description,
  address: { '@type': 'PostalAddress', streetAddress: 'Lake Road', addressLocality: 'Yercaud', addressRegion: 'Tamil Nadu', postalCode: '636602', addressCountry: 'IN' },
  geo: { '@type': 'GeoCoordinates', latitude: 11.7841942, longitude: 78.2082454 },

  sameAs: ['https://maps.app.goo.gl/DnvJDBDKXe8s1Rmi9', 'https://salem.nic.in/tourist-place/images-of-yercaudlake/']
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout title={title} description={description} image="/images/yercaud-lake-boathouse.jpg" imageAlt="Yercaud Lake & Boat House (Emerald Lake) — Lake Road, Yercaud, Tamil Nadu" jsonLd={[attraction, faqSchema]} locale="en" path="/">
  <section class="hero-pattern relative overflow-hidden text-white">
    <div class="container-shell grid min-h-[620px] items-center gap-10 py-16 lg:grid-cols-[1.12fr_.88fr]">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm font-extrabold">Salem District · Shevaroy Hills</p>
        <h1 class="text-4xl font-black leading-[1.13] tracking-[-.035em] sm:text-6xl">Yercaud Lake<br /><span class="text-[#f5d98d]"> &amp; Boat House</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/86">Practical information to quietly enjoy the lake’s main waterbody, also called Emerald Lake or the Big Lake.</p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm font-bold"><span class="rounded-full bg-white/12 px-4 py-2">★ 4.1 · 23,888 · Google Maps · checked 25 Oct 2026</span><span class="rounded-full bg-white/12 px-4 py-2">Yercaud · Yercaud</span></div>
        <div class="mt-8 flex flex-wrap gap-3"><a href="#map" class="rounded-full bg-[#f4cc6b] px-5 py-3 font-extrabold text-[#18352f] no-underline">View map</a><a href="#planning" class="rounded-full border border-white/35 px-5 py-3 font-extrabold text-white no-underline">Plan your trip</a></div>
      </div>
      <div class="glass rounded-[2rem] p-6 text-[#173d3b] shadow-2xl">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">◷</div><p class="mt-2 text-xs font-black text-[#0d6d70]">General hours</p><p class="mt-1 text-lg font-black">09:00–18:00</p><p class="mt-1 text-xs text-[#4d635e]">Maps snapshot 25 Oct 2026; boat hours differ</p></div>
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">⛵</div><p class="mt-2 text-xs font-black text-[#0d6d70]">Key experience</p><p class="mt-1 text-lg font-black">Lake boat ride</p><p class="mt-1 text-xs text-[#4d635e]">Confirm weather / operation</p></div>
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">⌖</div><p class="mt-2 text-xs font-black text-[#0d6d70]">Address</p><p class="mt-1 font-extrabold">Lake Road, Yercaud</p><p class="mt-1 text-xs text-[#4d635e]">Tamil Nadu 636602</p></div>
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">◌</div><p class="mt-2 text-xs font-black text-[#0d6d70]">Suggested time</p><p class="mt-1 text-lg font-black">1.5–2.5 hr</p><p class="mt-1 text-xs text-[#4d635e]">Access, queues and your pace vary</p></div>
        </div>
      </div>
    </div>
  </section>

<aside class="container-shell py-6"><div class="card p-6"><h2 class="text-xl font-black">Before you set out: lake and boat-house hours</h2><p class="mt-3">Google Maps listed 09:00–18:00 daily when checked 25 October 2026. The district general page dated 2018 lists 09:00–17:30 for boating. These differ in date and scope; confirm current boat-service hours, last tickets and interruptions at the boat house.</p><p class="mt-3"><a class="underline" href="https://salem.nic.in/tourist-place/images-of-yercaudlake/">District general page (2018)</a> · <a class="underline" href="https://salem.nic.in/boat-house-yercaud-2024/">District boat-house page (updated 2025)</a></p></div></aside>
  <section id="about" class="container-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_.9fr] lg:items-start">
      <div><p class="kicker">Heart of Yercaud</p><h2 class="section-title mt-3">Get to know the Big Lake</h2><div class="mt-6 space-y-5 text-[#415a54]">
        <p>The Salem District Administration lists the Big Lake of Yercaud as a key tourist spot. Among South Indian hill-station lakes it is distinctive as a natural lake, and its lakeside recreation area is noted in the public info.</p>
        <p>The boat house is the landmark experience of the lakeside. Before you travel, it is good to confirm the time, weather and boat-operation status via the local counter or an official source.</p>
      </div><div class="mt-7 flex flex-wrap gap-3"><a target="_blank" rel="noopener noreferrer" href="https://salem.nic.in/tourist-place/images-of-yercaudlake/" class="rounded-full bg-[#0d6d70] px-5 py-3 text-sm font-extrabold text-white no-underline">Salem district info</a><a target="_blank" rel="noopener noreferrer" href="https://salem.nic.in/gallery/yercaudlake/" class="rounded-full border border-[#0d6d70]/25 px-5 py-3 text-sm font-extrabold text-[#0d6d70] no-underline">Official photo gallery</a></div></div>
      <aside class="card overflow-hidden p-6"><div class="wave rounded-2xl p-6 text-white"><p class="text-sm font-extrabold text-white/75">Location</p><p class="mt-2 text-2xl font-black">11.7841942° N<br />78.2082454° E</p><div class="mt-5 h-px bg-white/20"></div><p class="mt-5 text-sm leading-7 text-white/80">Yercaud · Salem District · Tamil Nadu · India</p></div><p class="mt-5 text-sm leading-7 text-[#4a615b]">Use this Yercaud place map to plan arrival; a map pin does not establish the current visitor entrance, parking or accessible boarding.</p></aside>
    </div>
  </section>

  <section id="planning" class="bg-[#eaf4ee] py-16 md:py-22"><div class="container-shell"><p class="kicker">Trip planning</p><h2 class="section-title mt-3">Know before you go</h2>
    <div class="mt-9 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      <article class="card p-6"><div class="text-3xl">🎟</div><h3 class="mt-4 text-xl font-black text-[#0b4148]">Fee / boating cost</h3><p class="mt-3 text-sm leading-7 text-[#48605a]">Ask separately about lakeside access and a boat ticket. The district’s 2025 boat page gives different rates by type and capacity; it is not today’s confirmed offer. Ask which boats operate, ride duration, current total and any extras before paying.</p></article>
      <article class="card p-6"><div class="text-3xl">☀</div><h3 class="mt-4 text-xl font-black text-[#0b4148]">Best time</h3><p class="mt-3 text-sm leading-7 text-[#48605a]">Choose a time using the actual heat, rain, fog and your group’s needs. Confirm walking access and boat service separately; a morning or evening visit does not guarantee that boats operate.</p></article>
      <article class="card p-6"><div class="text-3xl">🅿</div><h3 class="mt-4 text-xl font-black text-[#0b4148]">Parking</h3><p class="mt-3 text-sm leading-7 text-[#48605a]">Parking near Lake Road / boat house varies by time. Crowds rise on weekends and holidays; arriving earlier is practical.</p></article>
      <article class="card p-6"><div class="text-3xl">⏱</div><h3 class="mt-4 text-xl font-black text-[#0b4148]">Time to spend</h3><p class="mt-3 text-sm leading-7 text-[#48605a]">A shorter visit might allow 1.5–2.5 hours as a planning estimate, depending on current access, queues, your pace and breaks. It does not guarantee boating or a complete circuit.</p></article>
    </div>
  </div></section>

  <WeatherSection locale="en" />

  <TransportSection locale="en" />

  <FacilitiesSection locale="en" />
  <SeasonalStrategy locale="en" />
  <Itineraries locale="en" />
  <HistorySection locale="en" />
  <StoriesSection locale="en" />
  <GallerySection locale="en" />

  <section id="nearby" class="bg-[#0b4148] py-16 text-white md:py-22"><div class="container-shell"><p class="text-xs font-black tracking-[.12em] text-[#b8e0cc]">Around the lake</p><h2 class="mt-3 text-3xl font-black sm:text-5xl">Food & nearby places</h2><div class="mt-9 grid gap-6 lg:grid-cols-2">
    <article class="rounded-[1.6rem] bg-white/8 p-7 ring-1 ring-white/10"><h3 class="text-2xl font-black">Local food</h3><p class="mt-3 text-white/74">This is not a commercial ranking. Use the food options around Lake Road and Yercaud town centre only as a guide.</p><ul class="mt-5 grid gap-3 text-sm text-white/82 sm:grid-cols-2"><li>☕ Yercaud coffee and hot drinks</li><li>🥘 Tamil Nadu meals / tiffin</li><li>🌶 Chilli bhajji and evening snacks</li><li>🍞 Bakery and family snack options</li></ul></article>
    <article class="rounded-[1.6rem] bg-white/8 p-7 ring-1 ring-white/10"><h3 class="text-2xl font-black">Nearby attractions</h3><ul class="mt-5 space-y-4 text-sm text-white/82"><li><strong class="text-white">Anna Park:</strong> a garden area to pair with the lake.</li><li><strong class="text-white">Kiliyur Falls:</strong> a natural spot to check by season and trail condition.</li><li><strong class="text-white">Pagoda Point:</strong> a popular hill viewpoint.</li><li><strong class="text-white">Ladies Seat:</strong> a viewpoint over hills and valley.</li></ul></article>
  </div></div></section>

  <VisitorResponsibility locale="en" />

  <section id="faq" class="container-shell py-16 md:py-24"><p class="kicker">Frequently asked questions</p><h2 class="section-title mt-3">Yercaud Lake — common questions</h2><div class="mt-8 grid gap-4 lg:grid-cols-2">{faq.map(([q, a]) => <details class="card group p-5"><summary class="cursor-pointer list-none pr-7 font-extrabold text-[#0b4148]">{q}</summary><p class="mt-4 text-sm leading-7 text-[#4a615b]">{a}</p></details>)}</div></section>

  <SourcesSection locale="en" />

  <section class="container-shell pb-4"><div class="card grid gap-7 p-7 lg:grid-cols-[1fr_auto] lg:items-center"><div><h2 class="text-2xl font-black text-[#0b4148]">Reconfirm changing info on the day of travel</h2><p class="mt-2 text-sm leading-7 text-[#4a615b]">Boat fare, operation hours, weather, parking and access can change on short notice. The official district info and local counter take priority.</p></div><a target="_blank" rel="noopener noreferrer" href="https://salem.nic.in/tourist-place/images-of-yercaudlake/" class="rounded-full bg-[#0d6d70] px-5 py-3 text-center text-sm font-extrabold text-white no-underline">Open official info</a></div></section>
</BaseLayout>
