---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import HistorySection from '../components/HistorySection.astro';
import StoriesSection from '../components/StoriesSection.astro';
import GallerySection from '../components/GallerySection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import TransportSection from '../components/TransportSection.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import Itineraries from '../components/Itineraries.astro';
import VisitorResponsibility from '../components/VisitorResponsibility.astro';
const title='ஏற்காடு ஏரி & படகு இல்லம் (Yercaud Lake & Boat House / Emerald Lake) — பயண வழிகாட்டி';
const description='ஏற்காடு ஏரி மற்றும் படகு இல்லப் பயணத்திற்கு தேதியுள்ள நேரத் தகவல், கட்டணப் பின்னணி, கவுண்டரில் உறுதிசெய்ய வேண்டியவை, போக்குவரத்து, வானிலை முன்னறிவிப்பு, புகைப்படங்கள் மற்றும் அருகிலுள்ள இடங்கள்.';
const pageUrl=Astro.site?new URL('/',Astro.site).href:undefined;
const faq=[
  [
    "ஏற்காடு எந்த மாவட்டத்தில் உள்ளது?",
    "ஏற்காடு ஏரி மற்றும் படகு இல்லம் சேலம் மாவட்டம் (Salem District), தமிழ்நாடு, இந்தியா என்ற இடத்தில் அமைந்துள்ளது. ஏற்காடு சேர்வராயன் மலைப்பகுதியில் (Shevaroy Hills) உள்ள ஒரு மலைவாசஸ்தலம்."
  ],
  [
    "ஏரிக்கு தனி நுழைவுக் கட்டணம் உண்டா?",
    "ஏரிக்கரையின் தற்போதைய நுழைவுக் கொள்கை உறுதி செய்யப்படவில்லை. இலவச ஏரி அணுகல், படகு மற்றும் தனிப் பூங்கா நுழைவு ஒரே ஏற்பாடு எனக் கருதாமல் உள்ளூரில் கேளுங்கள்."
  ],
  [
    "ஏற்காடு ஏரி எங்கு உள்ளது?",
    "தற்போதைய வரைபட முகவரி Lake To Ladies Seat Road, ஏற்காடு, தமிழ்நாடு 636602. சரியான இட வரைபடத்தைப் பயன்படுத்துங்கள்; புள்ளி 11.7841942,78.2082454."
  ],
  [
    "படகு சேவை எப்போது கிடைக்கும்?",
    "25 அக்டோபர் 2026 அன்று Google Maps பட்டியலில் தினமும் 09:00–18:00 உள்ளது. 2018 தேதியுள்ள மாவட்டப் பொதுப்பக்கம் படகிற்கு 09:00–17:30 எனக் குறிப்பிடுகிறது. வேறு தேதியும் சூழலும் உள்ள தகவல்கள் இவை; தற்போதைய படகு நேரம், கடைசி டிக்கெட் மற்றும் இடைநிறுத்தத்தைப் படகு இல்லத்தில் உறுதி செய்யுங்கள்."
  ],
  [
    "படகு கட்டணம் எவ்வளவு?",
    "ஏரிக்கரையைப் பார்ப்பதற்கான செலவையும் படகு டிக்கெட்டையும் தனியாகக் கேளுங்கள். 2025 மாவட்டப் படகு பக்கம் வகை மற்றும் பயணி எண்ணிக்கைக்கு வேறு கட்டணங்களைக் காட்டுகிறது; அது இன்றைய விலை உறுதி அல்ல. தற்போது கிடைக்கும் படகு, பயணநேரம், கட்டணம் மற்றும் கூடுதல் செலவைச் செலுத்துமுன் கேளுங்கள்."
  ],
  [
    "குழந்தைகளுடன் செல்லலாமா?",
    "உங்கள் குழுவின் வயது, ஏறுதல் மற்றும் பயணி எண்ணிக்கை விதிகளைக் கேளுங்கள். பணியாளர் மற்றும் பொருத்தமான உயிர்காப்பு உடை அறிவுரையைப் பின்பற்றுங்கள்; கிடைப்பது உறுதி அல்ல."
  ],
  [
    "பார்க்கிங் வசதி உள்ளதா?",
    "அனுமதிக்கப்பட்ட நிறுத்தம், கட்டணம் மற்றும் இறுதி நடைப்பகுதியை உள்ளூரில் உறுதி செய்யுங்கள்; இடம் கிடைப்பது உறுதி அல்ல."
  ],
  [
    "எவ்வளவு நேரம் ஒதுக்கலாம்?",
    "குறுகிய வருகைக்கு 1.5–2.5 மணி திட்டமிடும் ஆரம்பக் கணிப்பாக இருக்கலாம்; தற்போதைய அணுகல், வரிசை, நடை மற்றும் ஓய்வைப் பொறுத்து மாறும். படகு அல்லது முழுச் சுற்று உறுதி அல்ல."
  ],
  [
    "ஏரியில் நீந்தலாம் அல்லது குளிக்கலாமா?",
    "படகு சேவையிலிருந்து நீச்சல் அல்லது குளியல் அனுமதியை ஊகிக்காதீர்கள். நீரில் இறங்காமல் தற்போதைய பணியாளர் மற்றும் பாதுகாப்பு அறிவுரையைப் பின்பற்றுங்கள்."
  ],
  [
    "வார இறுதி / விடுமுறை நாட்களில் நிலைமை எப்படி இருக்கும்?",
    "வரிசை மற்றும் உள்ளூர் கட்டுப்பாட்டிற்கு நெகிழ்வான நேரம் வையுங்கள்; தேவைப்பட்டால் குறுகிய மாற்றுத் திட்டம் தேர்ந்தெடுங்கள். முன்னதாக வருவது படகு அல்லது நிறுத்தத்திற்கு உறுதி அல்ல."
  ],
  [
    "எந்தப் பருவங்களில் ஏற்காட்டைப் பார்ப்பது நல்லது?",
    "நாட்காட்டி உறுதியை விட தற்போதைய வெப்பம், UV, மழை, தெளிவு மற்றும் அதிகாரப்பூர்வ எச்சரிக்கையைப் பாருங்கள். மழை ஏரி நீர்மட்டம், பாதுகாப்பான அருவிப் பாதை அல்லது படகு கிடைப்பை உறுதி செய்யாது."
  ],
  [
    "அருகில் தங்குமிடம் அல்லது உணவகம் உள்ளதா?",
    "தேர்ந்தெடுக்கும் உணவகம் அல்லது தங்குமிடத்தின் உண்மையான முகவரி, நேரம், விலை மற்றும் முன்பதிவு விதியைச் சரிபாருங்கள். இது சரிபார்க்கப்பட்ட வணிகப் பட்டியல் அல்ல."
  ]
];
const attractionId=Astro.site?new URL('#attraction',Astro.site).href:undefined;
const attraction={
 '@context':'https://schema.org',
 '@type':'TouristAttraction',
 '@id':attractionId,
 name:'ஏற்காடு ஏரி மற்றும் படகு இல்லம் (எமரால்ட் ஏரி)',
 alternateName:['Yercaud Lake','Yercaud Lake & Boat House (Emerald Lake)','Yercaud Big Lake','Emerald Lake'],
 hasMap:'https://maps.app.goo.gl/DnvJDBDKXe8s1Rmi9',

 ...(pageUrl?{url:pageUrl}:{}),
 ...(pageUrl?{image:['images/yercaud-lake-panorama.jpg','images/yercaud-lake-boathouse.jpg','images/yercaud-lake-boating.jpg'].map(p=>new URL(p,pageUrl!).href)}:{}),
 description,
 address:{'@type':'PostalAddress',streetAddress:'Lake Road',addressLocality:'Yercaud',addressRegion:'Tamil Nadu',postalCode:'636602',addressCountry:'IN'},
 geo:{'@type':'GeoCoordinates',latitude:11.7841942,longitude:78.2082454},

 sameAs:['https://maps.app.goo.gl/DnvJDBDKXe8s1Rmi9','https://salem.nic.in/tourist-place/images-of-yercaudlake/']
};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout title={title} description={description} image="/images/yercaud-lake-boathouse.jpg" imageAlt="Yercaud Lake & Boat House (Emerald Lake) — Lake Road, Yercaud, Tamil Nadu" jsonLd={[attraction,faqSchema]} locale="ta" path="/">
  <section class="hero-pattern relative overflow-hidden text-white">
    <div class="container-shell grid min-h-[620px] items-center gap-10 py-16 lg:grid-cols-[1.12fr_.88fr]">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex rounded-full border border-white/30 bg-white/10 px-4 py-2 text-sm font-extrabold">சேலம் மாவட்டம் · சேர்வராயன் மலைப்பகுதி</p>
        <h1 class="text-4xl font-black leading-[1.13] tracking-[-.035em] sm:text-6xl">ஏற்காடு ஏரி<br/><span class="text-[#f5d98d]">மற்றும் படகு இல்லம்</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/86">எமரால்ட் ஏரி அல்லது பெரிய ஏரி எனவும் அழைக்கப்படும் ஏற்காட்டின் முக்கிய நீர்நிலையை அமைதியாக அனுபவிக்கத் தேவையான நடைமுறை தகவல்கள்.</p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm font-bold"><span class="rounded-full bg-white/12 px-4 py-2">★ 4.1 · 23,888 · Google Maps · 25 அக் 2026</span><span class="rounded-full bg-white/12 px-4 py-2">Yercaud · ஏற்காடு</span></div>
        <div class="mt-8 flex flex-wrap gap-3"><a href="#வரைபடம்" class="rounded-full bg-[#f4cc6b] px-5 py-3 font-extrabold text-[#18352f] no-underline">வரைபடத்தைப் பார்க்கவும்</a><a href="#திட்டமிடல்" class="rounded-full border border-white/35 px-5 py-3 font-extrabold text-white no-underline">பயணத்தைத் திட்டமிடவும்</a></div>
      </div>
      <div class="glass rounded-[2rem] p-6 text-[#173d3b] shadow-2xl">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">◷</div><p class="mt-2 text-xs font-black text-[#0d6d70]">பொது நேரம்</p><p class="mt-1 text-lg font-black">09:00–18:00</p><p class="mt-1 text-xs text-[#4d635e]">25 அக் 2026 வரைபடப் பதிவு; படகு நேரம் வேறுபடுகிறது</p></div>
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">⛵</div><p class="mt-2 text-xs font-black text-[#0d6d70]">முக்கிய அனுபவம்</p><p class="mt-1 text-lg font-black">ஏரிப் படகு பயணம்</p><p class="mt-1 text-xs text-[#4d635e]">வானிலை/செயல்பாட்டை உறுதிப்படுத்தவும்</p></div>
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">⌖</div><p class="mt-2 text-xs font-black text-[#0d6d70]">முகவரி</p><p class="mt-1 font-extrabold">லேக் ரோடு, ஏற்காடு</p><p class="mt-1 text-xs text-[#4d635e]">தமிழ்நாடு 636602</p></div>
          <div class="rounded-2xl bg-white/75 p-5"><div class="text-2xl">◌</div><p class="mt-2 text-xs font-black text-[#0d6d70]">பரிந்துரைக்கப்படும் நேரம்</p><p class="mt-1 text-lg font-black">1.5–2.5 மணி</p><p class="mt-1 text-xs text-[#4d635e]">அணுகல், வரிசை, நடை வேகம் மாறும்</p></div>
        </div>
      </div>
    </div>
  </section>

<aside class="container-shell py-6"><div class="card p-6"><h2 class="text-xl font-black">புறப்படுமுன்: ஏரியும் படகு இல்ல நேரமும்</h2><p class="mt-3">25 அக்டோபர் 2026 அன்று Google Maps பட்டியலில் தினமும் 09:00–18:00 உள்ளது. 2018 தேதியுள்ள மாவட்டப் பொதுப்பக்கம் படகிற்கு 09:00–17:30 எனக் குறிப்பிடுகிறது. வேறு தேதியும் சூழலும் உள்ள தகவல்கள் இவை; தற்போதைய படகு நேரம், கடைசி டிக்கெட் மற்றும் இடைநிறுத்தத்தைப் படகு இல்லத்தில் உறுதி செய்யுங்கள்.</p><p class="mt-3"><a class="underline" href="https://salem.nic.in/tourist-place/images-of-yercaudlake/">மாவட்டப் பொதுப்பக்கம் (2018)</a> · <a class="underline" href="https://salem.nic.in/boat-house-yercaud-2024/">மாவட்டப் படகு இல்லப் பக்கம் (2025)</a></p></div></aside>
  <section id="அறிமுகம்" class="container-shell py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_.9fr] lg:items-start">
      <div><p class="kicker">ஏற்காட்டின் மைய நீர்நிலை</p><h2 class="section-title mt-3">பெரிய ஏரியை அறிந்துகொள்ளுங்கள்</h2><div class="mt-6 space-y-5 text-[#415a54]">
        <p>சேலம் மாவட்ட நிர்வாகம் ஏற்காட்டின் பெரிய ஏரியை முக்கிய சுற்றுலா இடமாகப் பதிவு செய்கிறது. தென்னிந்திய மலைவாசஸ்தல ஏரிகளில் இயற்கை ஏரி என்ற தனித்துவத்தையும், ஏரியைச் சுற்றியுள்ள பொழுதுபோக்கு பகுதிகளையும் அதன் பொதுத் தகவல் குறிப்பிடுகிறது.</p>
        <p>படகு இல்லம் ஏரிக்கரையின் அடையாளமான அனுபவமாக உள்ளது. பயணத்திற்கு முன் நேரம், வானிலை மற்றும் படகு இயக்க நிலையை உள்ளூர் கவுண்டர் அல்லது அதிகாரப்பூர்வ தகவல் மூலம் உறுதிப்படுத்துவது நல்லது.</p>
      </div><div class="mt-7 flex flex-wrap gap-3"><a target="_blank" rel="noopener noreferrer" href="https://salem.nic.in/tourist-place/images-of-yercaudlake/" class="rounded-full bg-[#0d6d70] px-5 py-3 text-sm font-extrabold text-white no-underline">சேலம் மாவட்டத் தகவல்</a><a target="_blank" rel="noopener noreferrer" href="https://salem.nic.in/gallery/yercaudlake/" class="rounded-full border border-[#0d6d70]/25 px-5 py-3 text-sm font-extrabold text-[#0d6d70] no-underline">அதிகாரப்பூர்வ படத்தொகுப்பு</a></div></div>
